# ============================================
# CANLIFAL.COM - Environment Variables
# ============================================
# Bu dosyayı .env olarak kopyalayıp değerleri doldurun
# cp .env.example .env
# ============================================

# --- Authentication ---
NEXTAUTH_SECRET=              # openssl rand -base64 32 ile oluşturun
NEXTAUTH_URL=                 # Production URL (örn: https://canlifal.com)

# --- Database ---
DATABASE_URL=                 # PostgreSQL bağlantı string'i (örn: postgresql://user:pass@host:5432/dbname)

# --- Google OAuth (SSO) ---
GOOGLE_CLIENT_ID=             # Google Cloud Console > Credentials
GOOGLE_CLIENT_SECRET=         # Google Cloud Console > Credentials
GOOGLE_SITE_VERIFICATION=     # Google Search Console doğrulama kodu

# --- LLM / AI API ---
ABACUSAI_API_KEY=             # LLM API anahtarı (OpenAI uyumlu endpoint)

# --- AWS S3 (Dosya Depolama) ---
AWS_PROFILE=                  # AWS profil adı (veya boş bırakıp key/secret kullanın)
AWS_REGION=                   # AWS bölgesi (örn: eu-central-1)
AWS_BUCKET_NAME=              # S3 bucket adı
AWS_FOLDER_PREFIX=            # S3 klasör prefix'i (örn: canlifal/)

# --- OneSignal (Push Bildirimler) ---
NEXT_PUBLIC_ONESIGNAL_APP_ID= # OneSignal uygulama ID'si (client-side)
ONESIGNAL_REST_API_KEY=       # OneSignal REST API anahtarı (server-side)

# --- Agora (Sesli/Görüntülü Arama) ---
AGORA_APP_ID=                 # Agora.io App ID (server-side)
AGORA_APP_CERTIFICATE=        # Agora.io App Certificate (server-side)
NEXT_PUBLIC_AGORA_APP_ID=     # Agora.io App ID (client-side)

# --- TRTC (Tencent Real-Time Communication) ---
TRTC_SDK_APP_ID=              # TRTC SDK App ID (server-side)
TRTC_SDK_SECRET_KEY=          # TRTC SDK Secret Key (server-side)
NEXT_PUBLIC_TRTC_SDK_APP_ID=  # TRTC SDK App ID (client-side)

# --- Harici API'ler ---
FOOTBALL_DATA_API_KEY=        # football-data.org API anahtarı (canlı maç skorları)
TMDB_API_KEY=                 # TMDB API anahtarı (film/dizi verileri)
YOUTUBE_API_KEY=              # YouTube Data API v3 anahtarı
TIKTOK_CLIENT_KEY=            # TikTok Developer API client key
TIKTOK_CLIENT_SECRET=         # TikTok Developer API client secret

# --- Bildirim ID'leri ---
# Bu ID'ler bildirim servisi tarafından otomatik atanır
# Yeni kurulumda register_notification ile oluşturulmalıdır
NOTIF_ID_NEW_USER_SIGNUP=
NOTIF_ID_CONTACT_FORM_SUBMISSION=
NOTIF_ID_WELCOME_EMAIL=
NOTIF_ID_LOW_CREDITS_WARNING=
NOTIF_ID_FORTUNE_READING_SUMMARY=
NOTIF_ID_LETIIM_FORMU=
NOTIF_ID_KREDI_SATN_ALMA=
NOTIF_ID_YENI_KULLANC_KAYD=
NOTIF_ID_FALC_BAVURUSU=
NOTIF_ID_DEME_BILDIRIMI=
NOTIF_ID_IFRE_SFRLAMA=

# --- Diğer ---
WEB_APP_ID=                   # Uygulama ID'si
BOT_CRON_SECRET=              # Bot/cron job güvenlik anahtarı
