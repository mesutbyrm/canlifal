# ============================================
# CANLIFAL.COM - Environment Variables
# ============================================
# Bu dosyayı .env olarak kopyalayıp değerleri doldurun
# cp .env.example .env
# ============================================

# --- Authentication ---
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# --- Database ---
DATABASE_URL=

# --- Google OAuth (SSO) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SITE_VERIFICATION=

# --- LLM / AI API ---
ABACUSAI_API_KEY=

# --- AWS S3 (Dosya Depolama) ---
AWS_PROFILE=
AWS_REGION=
AWS_BUCKET_NAME=
AWS_FOLDER_PREFIX=

# --- OneSignal (Push Bildirimler) ---
NEXT_PUBLIC_ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# --- Agora (Sesli/Görüntülü Arama) ---
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
NEXT_PUBLIC_AGORA_APP_ID=

# --- TRTC (Tencent Real-Time Communication) ---
TRTC_SDK_APP_ID=
TRTC_SDK_SECRET_KEY=
NEXT_PUBLIC_TRTC_SDK_APP_ID=

# --- Harici API'ler ---
FOOTBALL_DATA_API_KEY=
TMDB_API_KEY=
YOUTUBE_API_KEY=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Bildirim ID'leri ---
# Bu ID'ler bildirim servisi tarafından otomatik atanır
# Yeni kurulumda register_notification ile oluşturulmalıdır
NOTIF_ID_NEW_USER_SIGNUP=
NOTIF_ID_CONTACT_FORM_SUBMISSION=
NOTIF_ID_WELCOME_EMAIL=
NOTIF_ID_LOW_CREDITS_WARNING=
NOTIF_ID_FORTUNE_READING_SUMMARY=
NOTIF_ID_LETIIM_FORMU=
NOTIF_ID_KREDI_SATN_ALMA=
NOTIF_ID_YENI_KULLANC_KAYD=
NOTIF_ID_FALC_BAVURUSU=
NOTIF_ID_DEME_BILDIRIMI=
NOTIF_ID_IFRE_SFRLAMA=

# --- Diğer ---
WEB_APP_ID=
BOT_CRON_SECRET=

# ─────────────────────────────────────────────────────────────
# ENTEGRASYON SIR YÖNETİMİ (yalnızca örnek — gerçek değer YAZMAYIN)
# Bu değerler tercihen Admin Panel > Entegrasyonlar ekranından girilir.
# Aşağıdakiler yalnızca geriye dönük/acil durum yedeğidir.
# ─────────────────────────────────────────────────────────────

# Sır kasası şifreleme anahtarı (32 bayt = 64 hex karakter). ZORUNLU.
SECRETS_ENCRYPTION_KEY=

# ── SMS / OTP sağlayıcıları (Admin Panel'den yönetilir) ──
SMS_PROVIDER=
NETGSM_USERNAME=
NETGSM_PASSWORD=
NETGSM_HEADER=
VERIMOR_USERNAME=
VERIMOR_PASSWORD=
VERIMOR_SOURCE_ADDR=
ILETIMERKEZI_API_KEY=
ILETIMERKEZI_API_HASH=
ILETIMERKEZI_SENDER=
VATANSMS_API_ID=
VATANSMS_API_KEY=
VATANSMS_SENDER=
MUTLUCELL_USERNAME=
MUTLUCELL_PASSWORD=
MUTLUCELL_ORIGINATOR=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_SENDER=
TELNYX_API_KEY=
TELNYX_FROM=
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_SRC=
SINCH_SERVICE_PLAN_ID=
SINCH_API_TOKEN=
SINCH_FROM=
SINCH_REGION=
BIRD_ACCESS_KEY=
BIRD_ORIGINATOR=
CLICKSEND_USERNAME=
CLICKSEND_API_KEY=
CLICKSEND_FROM=

# ── Apple In-App Purchase ──
APPLE_IAP_SHARED_SECRET=

# ── Google Play Billing ──
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
