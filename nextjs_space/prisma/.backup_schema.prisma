  tellerId    String
  senderId    String
  giftTypeId  String
  quantity    Int      @default(1)
  totalPrice  Int      // total jetons spent
  message     String?
  createdAt   DateTime @default(now())

  @@index([tellerId])
  @@index([senderId])
  @@index([createdAt])
  @@map("teller_gifts")
}
model SiteAnnouncement {
