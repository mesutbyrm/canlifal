  agencyNote       String?
  // Admin approval stage
  adminNote        String?
  processedBy      String?
  processedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
  @@index([agencyId])
  @@index([status])
  @@index([createdAt])
  @@map("withdrawal_requests")
}

// Teller Awards - medium of the day/week/month
