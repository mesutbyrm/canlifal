  slug        String   @unique // fal-carki, tarot-sec, memory, quiz, sans-kutusu, sayi-tahmin
  title       String
  description String?
  icon        String   @default("🎮")
  isActive    Boolean  @default(true)
  entryFee    Int      @default(0) // jeton cost to play
