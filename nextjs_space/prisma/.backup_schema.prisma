  claimed   Boolean  @default(false)
  updatedAt DateTime @default(now()) @updatedAt
  createdAt DateTime @default(now())

  @@unique([userId, missionId, dayKey])
  @@index([userId, dayKey])
  @@map("user_mission_progress")
}

// ============================================================
// PK (Battle) System — TikTok/Bigo-style broadcaster-vs-broadcaster
// Phase 1: request/accept/reject/cancel flow, timed duration, live
// scoring (host vs guest), final sprint (last 30s), winner/draw result.
// Fully additive — does not touch existing GiftBattle (poll battles).
// ============================================================
model PkMatch {
  id            String    @id @default(cuid())
  // Left side (challenger / host who sent the request)
  hostUserId    String
  hostStreamId  String
  hostName      String?
  hostImage     String?
  // Right side (opponent who receives the request)
  guestUserId   String
  guestStreamId String?
  guestName     String?
  guestImage    String?
  // pending | accepted | live | finished | cancelled | rejected | expired
  status        String    @default("pending")
  durationSec   Int       @default(180) // 60 | 180 | 300 | 600
  hostScore     Int       @default(0) // gross jetons gifted to host side
  guestScore    Int       @default(0) // gross jetons gifted to guest side
  // host_win | guest_win | draw | left_win | right_win (null until finished)
  result        String?
  winnerUserId  String?
  finalSprint   Boolean   @default(false) // set true in the last 30 seconds
  // ── Phase 2: multi-guest & team PK ──────────────────────────────
  mode          String    @default("1v1") // 1v1 | guest | team
  seatCount     Int       @default(2) // total seats (guest: up to 9; team: even 2/4/6/8)
  leftScore     Int       @default(0) // team mode: aggregate gross for Sol team
  rightScore    Int       @default(0) // team mode: aggregate gross for Sağ team
  leftName      String? // team label (default "Takım Sol")
  rightName     String? // team label (default "Takım Sağ")
  seats         PkSeat[]
  requestedAt   DateTime  @default(now())
  respondedAt   DateTime?
  startedAt     DateTime?
  endsAt        DateTime?
  finishedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([hostUserId, status])
  @@index([guestUserId, status])
  @@index([status, endsAt])
  @@index([hostStreamId])
  @@index([guestStreamId])
  @@index([status, mode])
  @@map("pk_matches")
}

// A seat occupancy in a multi-guest / team PK room (Phase 2).
model PkSeat {
  id        String    @id @default(cuid())
  matchId   String
  match     PkMatch   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  seatIndex Int // 0-based position in the room
  team      String    @default("none") // left | right | none (guest mode)
  userId    String
  userName  String?
  userImage String?
  streamId  String? // the guest's own stream if they are broadcasting
  score     Int       @default(0) // gross jetons gifted to this guest
  status    String    @default("active") // active | left | kicked
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([matchId, seatIndex])
  @@index([matchId, status])
  @@index([userId, status])
  @@map("pk_seats")
}

// ── Phase 3: per-participant result row (written at finalize) ──────
// One row per user per finished match. Powers leaderboards & stats.
model PkParticipant {
  id         String   @id @default(cuid())
  matchId    String
  userId     String
  mode       String // 1v1 | guest | team
  side       String // host | guest | left | right | seat
  score      Int      @default(0) // gross jetons this user pulled in during the match
  outcome    String // win | loss | draw | completed
  finishedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([matchId, userId])
  @@index([userId, finishedAt])
  @@index([finishedAt])
  @@index([outcome, finishedAt])
  @@map("pk_participants")
}

// ── Phase 3: all-time aggregated PK stats per user (O(1) profile read) ──
model PkStat {
  userId        String    @id
  matches       Int       @default(0)
  wins          Int       @default(0)
  losses        Int       @default(0)
  draws         Int       @default(0)
  totalScore    Int       @default(0) // cumulative gross pulled in across all PK
  bestScore     Int       @default(0) // best single-match score
  currentStreak Int       @default(0) // consecutive wins (resets on non-win)
  bestStreak    Int       @default(0)
  lastPlayedAt  DateTime?
  updatedAt     DateTime  @updatedAt
  createdAt     DateTime  @default(now())

  @@index([wins])
  @@index([totalScore])
  @@map("pk_stats")
}

// ── Phase 3: premium in-match events (score multipliers) ───────────
model PkEvent {
  id         String   @id @default(cuid())
  matchId    String
  // lucky_gift | golden_minute | double_score | final_frenzy
  type       String
  multiplier Float    @default(2.0)
  startsAt   DateTime @default(now())
  endsAt     DateTime
  createdBy  String // userId (host) or admin who triggered it
  createdAt  DateTime @default(now())

  @@index([matchId, endsAt])
  @@map("pk_events")
}

// ── TRTC Webhook Event Log ─────────────────────────────────────────
model TrtcWebhookLog {
  id           String   @id @default(cuid())
  eventGroupId Int // 1=Room, 2=Media, 3=Recording, 4=Relay
  eventType    Int // 101=RoomCreated, 102=RoomDissolved, 103=Enter, 104=Leave, 105=RoleSwitch
  sdkAppId     Int
  roomId       String? // TRTC room ID
  userId       String? // TRTC user ID (our user cuid)
  payload      String   @db.Text // full JSON body
  processedOk  Boolean  @default(true)
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([eventGroupId, eventType])
  @@index([roomId])
  @@index([userId])
  @@index([createdAt])
  @@map("trtc_webhook_logs")
}

// ── Phase 3: moderation — PK ban list ──────────────────────────────
model PkBan {
  id        String    @id @default(cuid())
  userId    String
  reason    String?
  bannedBy  String // admin userId
  active    Boolean   @default(true)
  expiresAt DateTime? // null = permanent
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, active])
  @@map("pk_bans")
}

// User-level blocks (profile level, not room/stream specific)
model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("user_blocks")
}

// User reports
model UserReport {
  id         String   @id @default(cuid())
  reporterId String
  reportedId String
