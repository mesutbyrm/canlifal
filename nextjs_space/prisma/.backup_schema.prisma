// CRITICAL: This schema file is shared across multiple applications. Only make edits with explicit user consent. Changes here affect all apps using this database.

generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "/home/ubuntu/fortune_telling_platform/nextjs_space/node_modules/.prisma/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
  id                     String                  @id @default(cuid())
  email                  String                  @unique
  emailVerified          DateTime?
  password               String?
  name                   String
  username               String?                 @unique
  phone                  String?
  image                  String?
  preferredLanguage      String                  @default("tr")
  credits                Int                     @default(50)
  role                   String                  @default("user")
  membership             String                  @default("basic") // basic, premium, gold
  membershipExpiresAt    DateTime?
  createdAt              DateTime                @default(now())
  referralCode           String?                 @unique
  referralCreditsEarned  Int                     @default(0)
  referredById           String?
  // Profile fields
  bio                    String? // User bio/about text
  birthDate              DateTime?
  birthTime              String? // HH:mm format for rising sign calculation
  zodiacSign             String?
  risingSign             String?
  favoriteTeam           String?
  lastHoroscopeDate      DateTime? // Track when daily horoscope was last generated
  // Privacy settings
  messagePrivacy         String                  @default("everyone") // everyone, followers, nobody
  hideProfileViews       Boolean                 @default(false) // hide from profile view tracking
  // Theme preference
  theme                  String                  @default("mystical") // mystical, facebook
  // Jeton (token) balance for Bana Özel
  jetonBalance           Int                     @default(0)
  // Location for gift leaderboards / sender map (added, optional)
  city                   String?
  country                String?                 @default("TR")
  // Profile customization
  specialBadges          String? // JSON array of special badge types (vip, beta_tester, verified, etc.)
  profileEffect          String? // Profile background effect (sparkles, fire, rainbow, etc.)
  profileFrameId         String? // Selected profile frame ID
  profileFrame           ProfileFrame?           @relation("UserProfileFrame", fields: [profileFrameId], references: [id])
  adminAssignedFrameId   String? // Admin-assigned profile frame (overrides user selection)
  adminAssignedFrame     ProfileFrame?           @relation("UserAdminFrame", fields: [adminAssignedFrameId], references: [id])
  // Cosmetic selections (Part 13 premium cosmetics) - plain id/key references, no relation
  nameEffect             String? // Selected name-text effect key (gold, silver, neon, rainbow, ...)
  entranceEffectId       String? // Selected entrance (room-join) effect id
  chatBubbleId           String? // Selected chat bubble skin id
  micFrameId             String? // Selected microphone frame id
  avatarAccessoryIds     String? // JSON array of selected avatar accessory ids
  // Withdrawal settings (admin-controlled)
  withdrawalLimit        Int                     @default(0) // 0 means cannot withdraw
  // Statistics
  totalTimeSpentMinutes  Int                     @default(0)
  lastActiveAt           DateTime?
  activeDeviceToken      String?
  accounts               Account[]
  bannedOthers           ChatBan[]               @relation("Banner")
  bannedIn               ChatBan[]               @relation("BannedUser")
  chatMessages           ChatMessage[]
  mutedOthers            ChatMute[]              @relation("Muter")
  mutedIn                ChatMute[]              @relation("MutedUser")
  chatPresences          ChatPresence[]
  chatRoles              ChatUserRole[]
  ownedChatRooms         ChatRoom[]              @relation("RoomOwner")
  beneficiaryRooms       ChatRoom[]              @relation("RoomGiftBeneficiary")
  fortunes               Fortune[]
  fortuneTellerProfile   LiveFortuneTeller?
  liveSessions           LiveSession[]           @relation("SessionUser")
  notifications          Notification[]
  passwordResets         PasswordResetToken[]
  referredHistory        Referral[]              @relation("Referred")
  referralHistory        Referral[]              @relation("Referrer")
  sessions               Session[]
  socialComments         SocialComment[]
  socialLikes            SocialLike[]
  socialPosts            SocialPost[]
  payments               Payment[]
  referredBy             User?                   @relation("UserReferrals", fields: [referredById], references: [id])
  referrals              User[]                  @relation("UserReferrals")
  videoStreams           VideoStream[]
  videoStreamComments    VideoStreamComment[]
  videoStreamLikes       VideoStreamLike[]
  streamGifts            StreamGift[]
  sentChatRoomGifts      ChatRoomGift[]          @relation("ChatGiftSender")
  receivedChatRoomGifts  ChatRoomGift[]          @relation("ChatGiftRecipient")
  followers              Follow[]                @relation("Following")
  following              Follow[]                @relation("Follower")
  sentMessages           DirectMessage[]         @relation("SentMessages")
  receivedMessages       DirectMessage[]         @relation("ReceivedMessages")
  conversationsAsUser1   Conversation[]          @relation("ConversationUser1")
  conversationsAsUser2   Conversation[]          @relation("ConversationUser2")
  sentRequests           MessageRequest[]        @relation("SentRequests")
  receivedRequests       MessageRequest[]        @relation("ReceivedRequests")
  dreamComments          DreamComment[]
  dreamFavorites         DreamFavorite[]
  dreamViews             DreamView[]
  dreamDiaryEntries      DreamDiaryEntry[]
  dailyLoginRewards      DailyLoginReward[]
  dreamContestEntries    DreamContestEntry[]
  dreamContestVotes      DreamContestVote[]
  weeklyDreamReports     WeeklyDreamReport[]
  liveActivities         LiveActivity[]          @relation("userActivities")
  // XP & Level system
  xp                     Int                     @default(0)
  level                  Int                     @default(1)
  loginStreak            Int                     @default(0)
  lastLoginRewardDate    DateTime?               @db.Date
  // Agency system
  agencyMembership       AgencyUser?
  agencyLeaveRequests    AgencyLeaveRequest[]
  // Celebrity follows
  celebrityFollows       CelebrityFollow[]
  // Fan clubs
  fanClubMemberships     FanClubMember[]
  fanClubPosts           FanClubPost[]
  fanClubPostLikes       FanClubPostLike[]
  fanClubPolls           FanClubPoll[]
  fanClubPollVotes       FanClubPollVote[]
  // Celebrity posts
  celebrityPostLikes     CelebrityPostLike[]
  celebrityPostComments  CelebrityPostComment[]
  stories                UserStory[]
  // Bot system
  isBot                  Boolean                 @default(false)
  botProfile             BotProfile?
  // CFC (CanlıFal Coin) balance
  cfcBalance             Int                     @default(0)
  cfcPaymentRequests     CfcPaymentRequest[]
  devices                UserDevice[]
  shortVideos            ShortVideo[]
  shortVideoLikes        ShortVideoLike[]
  shortVideoComments     ShortVideoComment[]
  shortVideoViews        ShortVideoView[]
  shortVideoSaves        ShortVideoSave[]
  shortVideoCommentLikes ShortVideoCommentLike[]
  shortVideoMentions     ShortVideoMention[]     @relation("ShortVideoMentioned")
  blockedUsers           UserBlock[]             @relation("Blocker")
  blockedByUsers         UserBlock[]             @relation("Blocked")
  reportsMade            UserReport[]            @relation("Reporter")
  reportsReceived        UserReport[]            @relation("Reported")

  @@index([referralCode])
  @@index([isBot])
  @@index([referredById])
  @@index([username])
  @@map("users")
}

// Follow relationship between users
model BotProfile {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  personality      String // shy, aggressive, funny, flirty, serious
  age              Int
  city             String
  interests        String?   @db.Text // JSON array
  activityLevel    String    @default("medium") // low, medium, high
  activeHoursStart Int       @default(9) // 0-23
  activeHoursEnd   Int       @default(23) // 0-23
  isActive         Boolean   @default(true) // admin can enable/disable
  lastActionAt     DateTime?
  totalActions     Int       @default(0)
  createdAt        DateTime  @default(now())

  @@index([isActive])
  @@index([personality])
  @@map("bot_profiles")
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String // The user who is following
  followingId String // The user being followed
  createdAt   DateTime @default(now())
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

model Referral {
  id             String   @id @default(cuid())
  referrerId     String
  referredId     String
  creditsAwarded Int      @default(50)
  createdAt      DateTime @default(now())
  referred       User     @relation("Referred", fields: [referredId], references: [id], onDelete: Cascade)
  referrer       User     @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)

  @@unique([referrerId, referredId])
  @@index([referrerId])
  @@index([createdAt])
  @@map("referrals")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("password_reset_tokens")
}

model LiveFortuneTeller {
  id                 String             @id @default(cuid())
  userId             String             @unique
  displayName        String
  bio                String?
  specialties        String[]
  pricePerSession    Int                @default(100)
  rating             Float              @default(5.0)
  totalSessions      Int                @default(0)
  totalReviews       Int                @default(0)
  isOnline           Boolean            @default(false)
  isVerified         Boolean            @default(false)
  isActive           Boolean            @default(true)
  avatar             String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  applicationNote    String?
  applicationStatus  String             @default("pending")
  approvedAt         DateTime?
  banReason          String?
  bannedAt           DateTime?
  bonusCredits       Int                @default(0)
  freezeReason       String?
  frozenAt           DateTime?
  isBanned           Boolean            @default(false)
  isFrozen           Boolean            @default(false)
  rejectedAt         DateTime?
  totalEarnings      Int                @default(0)
  // Level system: bronze, silver, gold, diamond
  tellerLevel        String             @default("bronze") // bronze, silver, gold, diamond
  levelPoints        Int                @default(0) // Accumulated points for level calculation
  levelUpdatedAt     DateTime?
  // Teller permissions (admin controlled)
  canGoOnline        Boolean            @default(true)
  canChat            Boolean            @default(true)
  canStartSession    Boolean            @default(true)
  canSetPrice        Boolean            @default(false)
  canEditProfile     Boolean            @default(true)
  canViewEarnings    Boolean            @default(true)
  canWithdraw        Boolean            @default(false)
  // Kimlik doğrulama
  verificationDocUrl String?
  verificationStatus String             @default("none") // none, pending, approved, rejected
  verificationNote   String?
  maxSessionsPerDay  Int                @default(10)
  commissionRate     Int                @default(20)
  adminNotes         String?
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions           LiveSession[]
  reviews            LiveTellerReview[]
  warnings           TellerWarning[]

  @@index([isOnline])
  @@index([isVerified])
  @@index([rating])
  @@index([applicationStatus])
  @@index([isBanned])
  // Perf: teller list orderBy [isOnline desc, rating desc]
  @@index([isOnline, rating(sort: Desc)])
  @@map("live_fortune_tellers")
}

model TellerWarning {
  id        String            @id @default(cuid())
  tellerId  String
  reason    String
  issuedBy  String
  createdAt DateTime          @default(now())
  teller    LiveFortuneTeller @relation(fields: [tellerId], references: [id], onDelete: Cascade)

  @@index([tellerId])
  @@map("teller_warnings")
}

model LiveSession {
  id               String               @id @default(cuid())
  tellerId         String
  userId           String
  fortuneType      String
  status           String               @default("pending")
  creditsCharged   Int
  startedAt        DateTime?
  endedAt          DateTime?
  notes            String?
  createdAt        DateTime             @default(now())
  // Room and duration tracking
  roomId           String?              @unique
  maxMinutes       Int                  @default(5)
  minutesUsed      Int                  @default(0)
  creditsPerMinute Int                  @default(0)
  lastPingAt       DateTime?
  timerStarted     Boolean              @default(false)
  timerStartedAt   DateTime?
  messages         LiveSessionMessage[]
  teller           LiveFortuneTeller    @relation(fields: [tellerId], references: [id], onDelete: Cascade)
  user             User                 @relation("SessionUser", fields: [userId], references: [id], onDelete: Cascade)
  review           LiveTellerReview?
  chatSession      TellerChatSession?
  roomSignals      RoomSignal[]

  @@index([tellerId])
  @@index([userId])
  @@index([status])
  @@index([roomId])
  @@map("live_sessions")
}

// WebRTC Signaling for real-time communication
model RoomSignal {
  id         String      @id @default(cuid())
  sessionId  String
  senderId   String
  receiverId String
  signalType String // offer, answer, ice-candidate
  signalData String // JSON string of WebRTC signal data
  processed  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  session    LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([receiverId, processed])
  @@map("room_signals")
}

model LiveSessionMessage {
  id        String      @id @default(cuid())
  sessionId String
  senderId  String
  message   String
  createdAt DateTime    @default(now())
  session   LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("live_session_messages")
}

model LiveTellerReview {
  id        String            @id @default(cuid())
  tellerId  String
  sessionId String            @unique
  rating    Int
  comment   String?
  createdAt DateTime          @default(now())
  session   LiveSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  teller    LiveFortuneTeller @relation(fields: [tellerId], references: [id], onDelete: Cascade)

  @@index([tellerId])
  @@map("live_teller_reviews")
}

model Fortune {
  id          String       @id @default(cuid())
  userId      String
  fortuneType String
  inputData   String
  aiResponse  String
  language    String
  viewCount   Int          @default(0)
  isSaved     Boolean      @default(false)
  isPinned    Boolean      @default(false)
  pinnedAt    DateTime?
  createdAt   DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  socialPosts SocialPost[]

  @@index([userId])
  @@index([fortuneType])
  @@index([createdAt])
  @@index([isPinned])
  @@map("fortunes")
}

model Translation {
  id               String @id @default(cuid())
  languageCode     String
  translationKey   String
  translationValue String

  @@unique([languageCode, translationKey])
  @@index([languageCode])
  @@map("translations")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model ChatRoom {
  id                    String           @id @default(cuid())
  slug                  String           @unique
  nameEn                String
  nameTr                String
  descEn                String
  descTr                String
  icon                  String
  isActive              Boolean          @default(true)
  isMuted               Boolean          @default(false)
  ownerId               String? // User who purchased/owns this room
  owner                 User?            @relation("RoomOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  giftCommissionPercent Int              @default(0) // 0-100, percentage of gift value going to beneficiary
  giftBeneficiaryId     String? // Who receives the commission (null = room owner)
  giftBeneficiary       User?            @relation("RoomGiftBeneficiary", fields: [giftBeneficiaryId], references: [id], onDelete: SetNull)
  backgroundImage       String? // Background image URL for room
  bannedWords           String?          @db.Text // JSON array of custom banned words set by room owner
  currentMusicVideoId   String? // Currently playing YouTube video ID
  currentMusicTitle     String? // Currently playing music title
  currentMusicStartedAt DateTime? // When the music started playing
  currentMusicDuration  String? // Duration string from YouTube (e.g. "3:45")
  djUserIds             String?          @db.Text // JSON array of user IDs who can DJ (max 5)
  activeDjId            String? // Currently active DJ user ID (who has permission to play right now)
  whitelistedWords      String?          @db.Text // JSON array of words marked as safe (not profanity)
  roomType              String           @default("FREE") // FREE, NORMAL, VIP
  password              String? // Room password (NORMAL, VIP only)
  welcomeMessage        String? // Welcome message for users joining
  pinnedAnnouncement    String? // Pinned announcement text
  tags                  String? // Comma-separated tags
  bannerImage           String? // Room banner image URL
  createdAt             DateTime         @default(now())
  bans                  ChatBan[]
  messages              ChatMessage[]
  mutes                 ChatMute[]
  presences             ChatPresence[]
  userRoles             ChatUserRole[]
  chatGifts             ChatRoomGift[]
  revenueLogs           RoomRevenueLog[]

  @@index([isActive, createdAt])
  @@index([ownerId])
  @@index([roomType])
  @@map("chat_rooms")
}

// Gifts sent in chat rooms
model ChatRoomGift {
  id               String   @id @default(cuid())
  roomId           String
  senderId         String
  recipientId      String
  giftTypeId       String
  quantity         Int      @default(1)
  totalPrice       Int // total cost
  currencyType     String   @default("jeton") // "jeton" or "cfc"
  commissionAmount Int      @default(0) // amount taken as commission
  beneficiaryId    String? // who received commission (null if no commission)
  createdAt        DateTime @default(now())
  room             ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender           User     @relation("ChatGiftSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient        User     @relation("ChatGiftRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  giftType         GiftType @relation(fields: [giftTypeId], references: [id])

  @@index([roomId])
  @@index([senderId])
  @@index([recipientId])
  @@index([roomId, senderId])
  @@index([roomId, createdAt(sort: Desc)])
  @@map("chat_room_gifts")
}

model ChatMessage {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  room      ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@index([userId])
  @@map("chat_messages")
}

model ChatPresence {
  id         String    @id @default(cuid())
  roomId     String
  userId     String
  nickname   String?
  isTyping   Boolean   @default(false)
  lastTyping DateTime?
  lastSeen   DateTime  @default(now())
  seatIndex  Int       @default(-1) // -1 = no seat, 0-14 = seat position
  room       ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId])
  @@index([roomId, lastSeen])
  @@map("chat_presences")
}

model ChatUserRole {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  role      String
  grantedBy String?
  createdAt DateTime @default(now())
  room      ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId])
  @@map("chat_user_roles")
}

model ChatMute {
  id        String    @id @default(cuid())
  roomId    String
  userId    String
  mutedBy   String
  reason    String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  muter     User      @relation("Muter", fields: [mutedBy], references: [id], onDelete: Cascade)
  room      ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User      @relation("MutedUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId])
  @@map("chat_mutes")
}

model ChatBan {
  id        String    @id @default(cuid())
  roomId    String
  userId    String
  bannedBy  String
  reason    String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  banner    User      @relation("Banner", fields: [bannedBy], references: [id], onDelete: Cascade)
  room      ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User      @relation("BannedUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId])
  @@map("chat_bans")
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

model SocialPost {
  id          String          @id @default(cuid())
  userId      String
  fortuneId   String?
  content     String
  postType    String
  fortuneType String?
  isPublic    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  imageUrl    String?
  isAuto      Boolean         @default(false)
  audioUrl    String?
  youtubeUrl  String?
  comments    SocialComment[]
  likes       SocialLike[]
  fortune     Fortune?        @relation(fields: [fortuneId], references: [id])
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([postType])
  // Perf: filtered feed (postType) sorted by createdAt desc
  @@index([postType, createdAt(sort: Desc)])
  @@map("social_posts")
}

model SocialComment {
  id        String     @id @default(cuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime   @default(now())
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
  @@map("social_comments")
}

model SocialLike {
  id        String     @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime   @default(now())
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@map("social_likes")
}

model AnonymousUser {
  id                String             @id @default(cuid())
  username          String             @unique
  deviceId          String             @unique
  credits           Int                @default(0)
  adsWatched        Int                @default(0)
  adsWatchedToday   Int                @default(0)
  lastAdDate        DateTime?
  fortunesUsed      Int                @default(0)
  createdAt         DateTime           @default(now())
  anonymousFortunes AnonymousFortune[]

  @@map("anonymous_users")
}

model AnonymousFortune {
  id              String        @id @default(cuid())
  anonymousUserId String
  fortuneType     String
  inputData       String
  aiResponse      String
  language        String
  createdAt       DateTime      @default(now())
  anonymousUser   AnonymousUser @relation(fields: [anonymousUserId], references: [id], onDelete: Cascade)

  @@index([anonymousUserId])
  @@map("anonymous_fortunes")
}

model SitePresence {
  id         String   @id @default(cuid())
  visitorId  String   @unique
  userId     String?
  lastSeen   DateTime @default(now())
  userAgent  String?
  path       String?
  deviceType String? // mobile, tablet, desktop
  isBot      Boolean  @default(false)
  botName    String?

  @@index([lastSeen])
  @@map("site_presences")
}

model SiteVisit {
  id         String   @id @default(cuid())
  visitorId  String
  userId     String?
  visitedAt  DateTime @default(now())
  path       String?
  userAgent  String?
  country    String?
  city       String?
  ipHash     String?
  deviceType String?
  isBot      Boolean  @default(false)
  botName    String?

  @@index([visitedAt])
  @@index([visitorId])
  @@index([country])
  @@map("site_visits")
}

model Notification {
  id           String   @id @default(cuid())
  userId       String
  type         String
  title        String?
  message      String
  data         String?
  postId       String?
  fromUserId   String?
  fromUserName String?
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  // Perf: "my notifications" list sorted by createdAt desc
  @@index([userId, createdAt(sort: Desc)])
  // Perf: unread notifications count + ordered list
  @@index([userId, isRead, createdAt(sort: Desc)])
  @@map("notifications")
}

// Credit Package for purchasing credits
model CreditPackage {
  id            String    @id @default(cuid())
  name          String
  nameEn        String?
  credits       Int
  price         Float
  currency      String    @default("TRY")
  stripePriceId String?
  isActive      Boolean   @default(true)
  isFeatured    Boolean   @default(false)
  bonusCredits  Int       @default(0)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  payments      Payment[]

  @@map("credit_packages")
}

// Payment/Purchase tracking
model Payment {
  id                    String         @id @default(cuid())
  userId                String
  packageId             String?
  stripeSessionId       String?        @unique
  stripePaymentIntentId String?        @unique
  amount                Float
  currency              String         @default("TRY")
  creditsAwarded        Int
  status                String         @default("pending") // pending, completed, failed, refunded
  paymentMethod         String?
  createdAt             DateTime       @default(now())
  completedAt           DateTime?
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  package               CreditPackage? @relation(fields: [packageId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([stripeSessionId])
  @@map("payments")
}

// Payment Methods Configuration
model PaymentMethod {
  id            String   @id @default(cuid())
  type          String   @unique // credit_card, bitcoin, bank_transfer
  name          String
  nameEn        String?
  description   String?
  descriptionEn String?
  isActive      Boolean  @default(true)
  config        String? // JSON string for configuration (bank details, wallet address, etc.)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("payment_methods")
}

// Platform settings for admin
model PlatformSettings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("platform_settings")
}

// Live Chat Session between user and fortune teller
model TellerChatSession {
  id            String              @id @default(cuid())
  liveSessionId String              @unique
  userId        String
  tellerId      String
  status        String              @default("active") // active, closed
  createdAt     DateTime            @default(now())
  closedAt      DateTime?
  liveSession   LiveSession         @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  messages      TellerChatMessage[]

  @@index([userId])
  @@index([tellerId])
  @@index([status])
  @@map("teller_chat_sessions")
}

// Messages in the live chat
model TellerChatMessage {
  id            String            @id @default(cuid())
  chatSessionId String
  senderId      String
  senderType    String // "user" or "teller"
  content       String
  messageType   String            @default("text") // text, image
  imageUrl      String?
  isRead        Boolean           @default(false)
  createdAt     DateTime          @default(now())
  chatSession   TellerChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)

  @@index([chatSessionId])
  @@index([createdAt])
  @@map("teller_chat_messages")
}

// TikTok-style Video Stream
model VideoStream {
  id             String               @id @default(cuid())
  userId         String
  title          String?
  description    String?
  status         String               @default("live") // live, ended
  viewerCount    Int                  @default(0)
  likeCount      Int                  @default(0)
  roomId         String               @unique @default(cuid())
  category       String? // fortune, chat, general
  thumbnailUrl   String?
  broadcastImage String? // Image URL for image-only broadcast mode
  isImageMode    Boolean              @default(false) // Whether broadcasting with image instead of video
  backgroundUrl  String? // Background image URL for the broadcast
  lastGiftAt     DateTime? // Last gift received timestamp (for auto-close)
  autoClosedAt   DateTime? // When stream was auto-closed due to no gifts
  startedAt      DateTime             @default(now())
  endedAt        DateTime?
  createdAt      DateTime             @default(now())
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments       VideoStreamComment[]
  likes          VideoStreamLike[]
  viewers        VideoStreamViewer[]
  gifts          StreamGift[]

  @@index([userId])
  @@index([status])
  @@index([startedAt])
  // Perf: live-list query filters by status (+category) and sorts by startedAt desc
  @@index([status, startedAt(sort: Desc)])
  @@index([status, category, startedAt(sort: Desc)])
  @@map("video_streams")
}

// Comments on video streams
model VideoStreamComment {
  id        String      @id @default(cuid())
  streamId  String
  userId    String
  content   String
  nickname  String? // Optional custom nickname for the comment
  isHidden  Boolean     @default(false) // Whether viewer is hidden in this stream
  createdAt DateTime    @default(now())
  stream    VideoStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([streamId])
  @@index([createdAt])
  @@map("video_stream_comments")
}

// Likes on video streams
model VideoStreamLike {
  id        String      @id @default(cuid())
  streamId  String
  userId    String
  createdAt DateTime    @default(now())
  stream    VideoStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([streamId, userId])
  @@index([streamId])
  @@map("video_stream_likes")
}

// Track viewers in video streams
model VideoStreamViewer {
  id         String      @id @default(cuid())
  streamId   String
  viewerId   String
  viewerName String?
  nickname   String? // Custom nickname for this stream
  isHidden   Boolean     @default(false) // Whether viewer wants to be hidden
  joinedAt   DateTime    @default(now())
  leftAt     DateTime?
  stream     VideoStream @relation(fields: [streamId], references: [id], onDelete: Cascade)

  @@unique([streamId, viewerId])
  @@index([streamId])
  @@map("video_stream_viewers")
}

// Gift types available for purchase
model GiftType {
  id                  String         @id @default(cuid())
  name                String
  nameEn              String
  icon                String // emoji or icon name
  animation           String? // animation type
  price               Int // price in credits
  sortOrder           Int            @default(0)
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())
  // ── Gift store: uploadable rich assets (added) ──
  thumbnailUrl        String? // small preview image (ready-to-use URL)
  assetUrl            String? // full gift asset URL (video/lottie/svga/gif/png)
  assetType           String?        @default("image") // image | video | lottie | svga | gif
  cloudStoragePath    String? // internal storage key for the asset
  thumbnailCloudPath  String? // internal storage key for the thumbnail
  category            String? // optional grouping (e.g. "luxury", "romantic")
  description         String?        @db.Text
  updatedAt           DateTime       @default(now()) @updatedAt
  // ── Premium ecosystem fields (added) ──
  soundUrl            String? // optional sound effect URL
  soundCloudPath      String? // internal storage key for the sound
  animationDurationMs Int? // animation duration in ms
  isFullscreen        Boolean        @default(false) // full-screen animation gift
  tier                String         @default("small") // small | big | huge (animation intensity)
  isPopular           Boolean        @default(false)
  isNew               Boolean        @default(false)
  isSpecialEvent      Boolean        @default(false)
  isHidden            Boolean        @default(false) // "gizli" gift — invisible until first sent/owned
  seasonStart         DateTime? // seasonal availability window start
  seasonEnd           DateTime? // seasonal availability window end
  isFeatured          Boolean        @default(false) // "Hediye Günü" highlight
  firstReleasedAt     DateTime? // album: first release date
  // ── Admin panel: static icon image, effect color & behavior flags (added) ──
  iconImageUrl        String? // static PNG/webP icon shown in panel/list (distinct from emoji `icon`)
  iconImageCloudPath  String? // internal storage key for the static icon image
  effectColor         String? // hex effect color, e.g. #FF6B6B
  comboEnabled        Boolean        @default(false) // gift supports combo sending
  isPremium           Boolean        @default(false) // premium gift
  // ── Görüneceği Yerler (visibility locations) ──
  visibleInVoiceRoom  Boolean        @default(true)
  visibleInLiveStream Boolean        @default(true)
  visibleInPK         Boolean        @default(true)
  visibleInProfile    Boolean        @default(false)
  visibleInMessaging  Boolean        @default(false)
  visibleInTrend      Boolean        @default(false)
  visibleInStories    Boolean        @default(false)
  visibleInFortune    Boolean        @default(false)
  visibleInNotification Boolean      @default(false)
  visibleAsMini       Boolean        @default(false) // mini animasyon
  visibleAsFullscreen Boolean        @default(false) // tam ekran animasyon
  // ── Hediye Türü (gift display type) ──
  displayType         String         @default("static") // static|animation|video|3d|lottie|effect|fullscreen|mini|continuous|play_once
  // ── Hediye Özellikleri (gift properties) ──
  requiresVip         Boolean        @default(false)
  eventOnly           Boolean        @default(false)
  pkOnly              Boolean        @default(false)
  liveOnly            Boolean        @default(false)
  voiceOnly           Boolean        @default(false)
  newUserOnly         Boolean        @default(false)
  timedCampaign       Boolean        @default(false)
  campaignStart       DateTime?
  campaignEnd         DateTime?
  isSeasonal          Boolean        @default(false)
  isReusable          Boolean        @default(true)
  dailySendLimit      Int?           // null = sınırsız
  // ── Animasyon Ayarları ──
  startDelayMs        Int?           // animasyon başlangıç gecikmesi (ms)
  displayDurationMs   Int?           // ekranda kalma süresi (ms)
  repeatCount         Int            @default(1) // tekrar sayısı (0 = sonsuz)
  volume              Int            @default(100) // ses seviyesi 0-100
  particleEffect      String?        // confetti|heart|star|light|glow|none
  hasVibration        Boolean        @default(false)
  hasColorChange      Boolean        @default(false)
  // ── Ekrandaki Konumu ──
  screenPosition      String         @default("center") // bottom|top|center|right|left|above_seat|user_avatar|room_center|fullscreen|background|message_area|header|footer
  animStartPoint      String?        // animasyon başlangıç noktası
  animEndPoint        String?        // animasyon bitiş noktası
  // ── Koleksiyon İlişkisi ──
  collectionId        String?
  collection          GiftCollection? @relation(fields: [collectionId], references: [id])
  // ── Müzik / ek ses dosyası ──
  musicUrl            String?        // hediye özel müzik
  musicCloudPath      String?        // müzik cloud key
  // ── Şanslı Hediye (Lucky Gift) ──
  isLucky             Boolean        @default(false) // şanslı hediye — gönderiminde jeton ödülü kazandırır
  // ── Senkronizasyon ──
  contentVersion      Int            @default(1) // her değişiklikte artar
  // ── Relations ──
  gifts               StreamGift[]
  chatRoomGifts       ChatRoomGift[]
  giftEvents          GiftEvent[]

  @@index([collectionId])
  @@index([displayType])
  @@index([contentVersion])
  @@map("gift_types")
}

// ── Hediye Koleksiyonları ──
model GiftCollection {
  id          String     @id @default(cuid())
  name        String     // Romantik, VIP, Komik, Lüks...
  nameEn      String     @default("")
  slug        String     @unique
  description String?    @db.Text
  iconEmoji   String?    // 💕, 👑, 🎉...
  iconUrl     String?    // opsiyonel ikon görseli
  iconCloudPath String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt
  gifts       GiftType[]

  @@map("gift_collections")
}

// ── Şanslı Hediye ödül kademeleri (admin tarafından yapılandırılır) ──
model LuckyGiftTier {
  id         String   @id @default(cuid())
  name       String   // "2x", "Jackpot 500x"...
  nameEn     String   @default("")
  multiplier Int      // ödül çarpanı — kazanılan jeton = betJetons * multiplier (0 = ödül yok)
  weight     Int      @default(1) // ağırlıklı olasılık payı (yüksek = daha olası)
  isJackpot  Boolean  @default(false) // jackpot kademesi — oda geneli duyuru tetikler
  color      String?  // hex renk, ör. #FFD700
  icon       String?  // emoji/ikon
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  contentVersion Int   @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([isActive])
  @@map("lucky_gift_tiers")
}

// ── Şanslı Hediye gönderim sonuçları (log + kazanç akışı) ──
model LuckyGiftReward {
  id         String   @id @default(cuid())
  userId     String
  giftTypeId String
  context    String?  // voice_room | live_stream | pk | profile | messaging
  contextId  String?  // roomId | streamId
  betJetons  Int      // harcanan jeton (hediye fiyatı * adet)
  quantity   Int      @default(1)
  multiplier Int      // uygulanan çarpan
  wonJetons  Int      // kazanılan jeton
  netJetons  Int      // wonJetons - betJetons (kar/zarar)
  isJackpot  Boolean  @default(false)
  tierId     String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([isJackpot, createdAt])
  @@index([createdAt])
  @@map("lucky_gift_rewards")
}

// Gifts sent during streams
model StreamGift {
  id             String      @id @default(cuid())
  streamId       String
  senderId       String
  giftTypeId     String
  quantity       Int         @default(1)
  totalPrice     Int // total credits spent (gross / display value)
  // ── Revenue split (added) ──
  receiverAmount Int         @default(0) // jetons credited to broadcaster
  siteAmount     Int         @default(0) // jetons kept by the site
  createdAt      DateTime    @default(now())
  stream         VideoStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  sender         User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  giftType       GiftType    @relation(fields: [giftTypeId], references: [id])

  @@index([streamId])
  @@index([senderId])
  @@map("stream_gifts")
}

// WebRTC signaling for video streams
model VideoStreamSignal {
  id         String   @id @default(cuid())
  streamId   String
  senderId   String
  receiverId String?
  signalType String // offer, answer, ice-candidate, join
  signalData String   @db.Text
  processed  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([streamId])
  @@index([receiverId, processed])
  @@map("video_stream_signals")
}

// Co-broadcasters in video streams
model StreamCoBroadcaster {
  id         String    @id @default(cuid())
  streamId   String
  userId     String
  status     String    @default("invited") // invited, active, ended
  isMuted    Boolean   @default(false)
  isVideoOff Boolean   @default(false)
  invitedAt  DateTime  @default(now())
  joinedAt   DateTime?
  leftAt     DateTime?

  @@unique([streamId, userId])
  @@index([streamId])
  @@index([userId])
  @@map("stream_co_broadcasters")
}

// Banned users from streams
model StreamBan {
  id           String   @id @default(cuid())
  streamId     String
  bannedUserId String
  reason       String?
  bannedAt     DateTime @default(now())

  @@unique([streamId, bannedUserId])
  @@index([streamId])
  @@map("stream_bans")
}

// Stream moderators (max 10 per stream, can mute users)
model StreamModerator {
  id       String   @id @default(cuid())
  streamId String
  userId   String
  addedAt  DateTime @default(now())

  @@unique([streamId, userId])
  @@index([streamId])
  @@index([userId])
  @@map("stream_moderators")
}

// PK Battle between two streamers (TikTok-style)
model PKBattle {
  id         String    @id @default(cuid())
  stream1Id  String // Challenger stream
  stream2Id  String // Opponent stream
  user1Id    String // Challenger user
  user2Id    String // Opponent user
  score1     Int       @default(0) // Gift points for stream1
  score2     Int       @default(0) // Gift points for stream2
  status     String    @default("pending") // pending, active, completed, cancelled, rejected
  duration   Int       @default(300) // Duration in seconds (default 5 min, admin-configurable)
  startedAt  DateTime?
  endedAt    DateTime?
  winnerId   String? // Winner user ID
  createdAt  DateTime  @default(now())
  // ── Live PK realtime fields (added) ──
  acceptedAt DateTime? // when the opponent accepted
  endsAt     DateTime? // authoritative countdown end (server clock) for synced timers
  isDraw     Boolean   @default(false) // true when scores are equal at finish
  winnerSide Int? // 1 or 2 (null on draw / not finished)
  scoreLogs  PkScore[]
  pkGifts    PkGift[]

  @@index([stream1Id])
  @@index([stream2Id])
  @@index([user1Id])
  @@index([user2Id])
  @@index([status])
  // Perf: quickly find a live battle for a given stream/user, and expired battles to finalize
  @@index([status, endsAt])
  @@map("pk_battles")
}

// Per-contributor score ledger inside a PK battle (for realtime aggregation & top-supporter).
model PkScore {
  id            String   @id @default(cuid())
  battleId      String
  side          Int // 1 = left/host, 2 = right/opponent
  contributorId String // the viewer who sent the gift that scored these points
  points        Int // gross jeton value added
  createdAt     DateTime @default(now())
  battle        PKBattle @relation(fields: [battleId], references: [id], onDelete: Cascade)

  @@index([battleId])
  @@index([battleId, side])
  @@index([battleId, contributorId])
  @@map("pk_scores")
}

// Detailed gift log attributed to a PK battle side.
model PkGift {
  id         String   @id @default(cuid())
  battleId   String
  side       Int // 1 or 2 (which side the gift scored for)
  senderId   String // viewer who sent
  receiverId String // the broadcaster on that side
  giftTypeId String
  quantity   Int      @default(1)
  points     Int // gross jeton value (added to that side's score)
  createdAt  DateTime @default(now())
  battle     PKBattle @relation(fields: [battleId], references: [id], onDelete: Cascade)

  @@index([battleId])
  @@index([battleId, side])
  @@index([senderId])
  @@map("pk_gifts")
}

// Active/past multi-guest seats on a live video stream (max 8 guests).
model LiveGuestSession {
  id          String    @id @default(cuid())
  streamId    String
  userId      String
  status      String    @default("active") // active, left, removed
  slot        Int // 1..8 seat index
  isMuted     Boolean   @default(false) // audio muted (self or by host)
  isVideoOff  Boolean   @default(false) // camera off
  mutedByHost Boolean   @default(false) // true when host force-muted
  joinedAt    DateTime  @default(now())
  lastSeenAt  DateTime  @default(now()) // heartbeat for reconnect detection
  leftAt      DateTime?

  @@unique([streamId, userId])
  @@index([streamId])
  @@index([streamId, status])
  @@index([userId])
  @@map("live_guest_sessions")
}

// Guest invites for multi-guest live streams.
model LiveGuestInvite {
  id          String    @id @default(cuid())
  streamId    String
  hostId      String // stream owner who invited
  guestId     String // invited user
  status      String    @default("pending") // pending, accepted, rejected, expired, cancelled
  createdAt   DateTime  @default(now())
  respondedAt DateTime?
  expiresAt   DateTime // invite auto-expires

  @@index([streamId])
  @@index([guestId, status])
  @@index([status, expiresAt])
  @@map("live_guest_invites")
}

// Fortune request types (admin configurable)
model FortuneRequestType {
  id          String   @id @default(cuid())
  name        String // Turkish name
  nameEn      String // English name
  icon        String   @default("☕") // Emoji icon
  jetonCost   Int // Required jetons
  description String? // Description
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fortuneRequests StreamFortuneRequest[]

  @@map("fortune_request_types")
}

// Fortune requests in video streams (sorted by jeton amount)
model StreamFortuneRequest {
  id          String    @id @default(cuid())
  streamId    String
  userId      String
  typeId      String? // Fortune request type
  nickname    String? // Optional nickname to show instead of real name
  isHidden    Boolean   @default(false) // Whether user wants to be hidden
  question    String?   @db.Text // User's custom question
  jetonAmount Int       @default(0) // Jetons spent for this request
  status      String    @default("pending") // pending, selected, completed, refunded
  refundedAt  DateTime? // When tokens were refunded (if applicable)
  createdAt   DateTime  @default(now())
  selectedAt  DateTime?
  completedAt DateTime?

  type FortuneRequestType? @relation(fields: [typeId], references: [id])

  @@unique([streamId, userId])
  @@index([streamId])
  @@index([userId])
  @@index([jetonAmount])
  @@index([status])
  @@map("stream_fortune_requests")
}

// Muted viewers in streams (by broadcaster or moderator)
model StreamMutedViewer {
  id        String    @id @default(cuid())
  streamId  String
  viewerId  String
  mutedBy   String // userId of who muted them
  reason    String?
  mutedAt   DateTime  @default(now())
  expiresAt DateTime? // null = permanent

  @@unique([streamId, viewerId])
  @@index([streamId])
  @@map("stream_muted_viewers")
}

// Direct Messages between users
model DirectMessage {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  content    String   @db.Text
  imageUrl   String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
  // Perf: DM thread history (both OR branches) sorted by createdAt desc + unread count
  @@index([senderId, receiverId, createdAt(sort: Desc)])
  @@index([receiverId, senderId, createdAt(sort: Desc)])
  @@index([receiverId, isRead])
  @@map("direct_messages")
}

// Conversation threads for DMs
model Conversation {
  id              String   @id @default(cuid())
  user1Id         String
  user2Id         String
  lastMessageAt   DateTime @default(now())
  lastMessageText String?
  createdAt       DateTime @default(now())
  user1           User     @relation("ConversationUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2           User     @relation("ConversationUser2", fields: [user2Id], references: [id], onDelete: Cascade)

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
  @@index([lastMessageAt])
  @@map("conversations")
}

// Message request (for users with restricted messaging)
model MessageRequest {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  status     String   @default("pending") // pending, accepted, rejected
  message    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  sender     User     @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
  @@index([status])
  @@map("message_requests")
}

// User Activity Statistics - tracks login sessions
model UserLoginSession {
  id         String    @id @default(cuid())
  userId     String
  loginAt    DateTime  @default(now())
  logoutAt   DateTime?
  duration   Int       @default(0) // in minutes
  deviceType String? // mobile, desktop, tablet
  browser    String?

  @@index([userId])
  @@index([loginAt])
  @@map("user_login_sessions")
}

// Daily activity tracking
model UserDailyActivity {
  id             String   @id @default(cuid())
  userId         String
  date           DateTime @db.Date
  minutesSpent   Int      @default(0)
  fortunesViewed Int      @default(0)
