  animation             String? // animation type
  price                 Int // price in credits
  sortOrder             Int             @default(0)
  isActive              Boolean         @default(true)
  createdAt             DateTime        @default(now())
  // ── Gift store: uploadable rich assets (added) ──
  thumbnailUrl          String? // small preview image (ready-to-use URL)
  assetUrl              String? // full gift asset URL (video/lottie/svga/gif/png)
  assetType             String?         @default("image") // image | video | lottie | svga | gif
  cloudStoragePath      String? // internal storage key for the asset
  thumbnailCloudPath    String? // internal storage key for the thumbnail
  // ── Media metadata (added; nullable/backward-compatible) ──
  assetWidth            Int? // intrinsic width in px (video/image)
  assetHeight           Int? // intrinsic height in px (video/image)
  assetDurationMs       Int? // media duration in ms (video/audio)
  assetMimeType         String? // e.g. video/mp4, image/png
  category              String? // optional grouping (e.g. "luxury", "romantic")
  description           String?         @db.Text
  updatedAt             DateTime        @default(now()) @updatedAt
  // ── Premium ecosystem fields (added) ──
  soundUrl              String? // optional sound effect URL
  soundCloudPath        String? // internal storage key for the sound
  animationDurationMs   Int? // animation duration in ms
  isFullscreen          Boolean         @default(false) // full-screen animation gift
  tier                  String          @default("small") // small | big | huge (animation intensity)
  isPopular             Boolean         @default(false)
  isNew                 Boolean         @default(false)
  isSpecialEvent        Boolean         @default(false)
  isHidden              Boolean         @default(false) // "gizli" gift — invisible until first sent/owned
  seasonStart           DateTime? // seasonal availability window start
  seasonEnd             DateTime? // seasonal availability window end
  isFeatured            Boolean         @default(false) // "Hediye Günü" highlight
  firstReleasedAt       DateTime? // album: first release date
  // ── Admin panel: static icon image, effect color & behavior flags (added) ──
  iconImageUrl          String? // static PNG/webP icon shown in panel/list (distinct from emoji `icon`)
  iconImageCloudPath    String? // internal storage key for the static icon image
  effectColor           String? // hex effect color, e.g. #FF6B6B
  comboEnabled          Boolean         @default(false) // gift supports combo sending
  isPremium             Boolean         @default(false) // premium gift
  // ── Görüneceği Yerler (visibility locations) ──
  visibleInVoiceRoom    Boolean         @default(true)
  visibleInLiveStream   Boolean         @default(true)
  visibleInPK           Boolean         @default(true)
  visibleInProfile      Boolean         @default(false)
  visibleInMessaging    Boolean         @default(false)
  visibleInTrend        Boolean         @default(false)
  visibleInStories      Boolean         @default(false)
  visibleInFortune      Boolean         @default(false)
  visibleInNotification Boolean         @default(false)
  visibleAsMini         Boolean         @default(false) // mini animasyon
  visibleAsFullscreen   Boolean         @default(false) // tam ekran animasyon
  // ── Hediye Türü (gift display type) ──
  displayType           String          @default("static") // static|animation|video|3d|lottie|effect|fullscreen|mini|continuous|play_once
  // ── Hediye Özellikleri (gift properties) ──
  requiresVip           Boolean         @default(false)
  eventOnly             Boolean         @default(false)
  pkOnly                Boolean         @default(false)
  liveOnly              Boolean         @default(false)
  voiceOnly             Boolean         @default(false)
  newUserOnly           Boolean         @default(false)
  timedCampaign         Boolean         @default(false)
  campaignStart         DateTime?
  campaignEnd           DateTime?
  isSeasonal            Boolean         @default(false)
  isReusable            Boolean         @default(true)
  dailySendLimit        Int? // null = sınırsız
  // ── Animasyon Ayarları ──
  startDelayMs          Int? // animasyon başlangıç gecikmesi (ms)
  displayDurationMs     Int? // ekranda kalma süresi (ms)
  repeatCount           Int             @default(1) // tekrar sayısı (0 = sonsuz)
  volume                Int             @default(100) // ses seviyesi 0-100
  particleEffect        String? // confetti|heart|star|light|glow|none
  hasVibration          Boolean         @default(false)
  hasColorChange        Boolean         @default(false)
  // ── Ekrandaki Konumu ──
  screenPosition        String          @default("center") // bottom|top|center|right|left|above_seat|user_avatar|room_center|fullscreen|background|message_area|header|footer
  animStartPoint        String? // animasyon başlangıç noktası
  animEndPoint          String? // animasyon bitiş noktası
  // ── Koleksiyon İlişkisi ──
  collectionId          String?
  collection            GiftCollection? @relation(fields: [collectionId], references: [id])
  // ── Müzik / ek ses dosyası ──
  musicUrl              String? // hediye özel müzik
  musicCloudPath        String? // müzik cloud key
  // ── Şanslı Hediye (Lucky Gift) ──
  isLucky               Boolean         @default(false) // şanslı hediye — gönderiminde jeton ödülü kazandırır
  // ── Gift Engine (professional queue/animation engine) ──
  // Explicit, admin-editable engine attributes. These are ADDITIVE; when null
  // the engine falls back to the legacy fields (tier/screenPosition/assetType/
  // animationDurationMs) so existing gifts keep working unchanged.
  priority              String          @default("MEDIUM") // SMALL | MEDIUM | LARGE | ULTRA
  animationType         String? // PNG | SVG | LOTTIE | MP4 | WEBM | PARTICLE
  displayArea           String? // FULL_SCREEN | CENTER | SEAT | BOTTOM | TOP
  seatEffect            String? // GLOW | SHAKE | PARTICLE | BORDER | PULSE | NONE
  seatEffectEnabled     Boolean         @default(true) // admin can toggle seat effect on/off
  soundEffectEnabled    Boolean         @default(true) // admin can toggle sound effect on/off
  comboWindowMs         Int             @default(4000) // window to keep a combo alive (ms)
  // ── Senkronizasyon ──
  contentVersion        Int             @default(1) // her değişiklikte artar
  // ── Relations ──
  gifts                 StreamGift[]
  chatRoomGifts         ChatRoomGift[]
  giftEvents            GiftEvent[]

  @@index([collectionId])
  @@index([displayType])
  @@index([contentVersion])
  @@index([priority])
  @@map("gift_types")
}

// ===========================================================================
// Gift Engine — professional per-room queue / combo / history engine.
// All three tables use plain scalar foreign keys (no @relation back-refs) so
// they are fully additive and do not touch the User / GiftType relation graph.
// Shared by web, Flutter and any future platform via the same backend.
// ===========================================================================

// Per-context FIFO gift queue. One independent queue per room/stream so a busy
// user in one room can never block another room. Clients play entries in
// queueIndex order; each entry is marked finished when its animation completes.
model GiftQueue {
  id          String    @id @default(cuid())
  context     String // voice_room | live_stream | pk
  contextId   String // roomId | streamId | battleId
  giftTypeId  String
  senderId    String
  receiverId  String
  quantity    Int       @default(1)
  combo       Int       @default(1)
  priority    String    @default("MEDIUM") // SMALL | MEDIUM | LARGE | ULTRA
  durationMs  Int       @default(3000)
  displayArea String    @default("CENTER")
  status      String    @default("pending") // pending | playing | finished
  queueIndex  Int       @default(0)
  payload     String    @db.Text // cached gift_received payload JSON (replay/late-join)
  createdAt   DateTime  @default(now())
  playedAt    DateTime?
  finishedAt  DateTime?

  @@index([contextId, status, queueIndex])
  @@index([contextId, createdAt])
  @@index([status, createdAt])
  @@map("gift_queue")
}

// Combo tracking: consecutive sends of the SAME gift by the SAME sender in the
// SAME context within comboWindowMs increment comboCount. Backend is the single
// source of truth for combo; clients only display the result.
model GiftCombo {
  id         String   @id @default(cuid())
  context    String
  contextId  String
  senderId   String
  giftTypeId String
  receiverId String?
  comboCount Int      @default(1)
  lastSentAt DateTime @default(now())
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@unique([contextId, senderId, giftTypeId])
  @@index([contextId, senderId])
  @@index([expiresAt])
  @@map("gift_combos")
}

// Unified send log for the engine (analytics / replay), independent of the
// existing ChatRoomGift / StreamGift financial records which are untouched.
model GiftHistory {
  id            String   @id @default(cuid())
  context       String
  contextId     String
  senderId      String
  receiverId    String
  giftTypeId    String
  quantity      Int      @default(1)
  combo         Int      @default(1)
  priority      String   @default("MEDIUM")
  coinAmount    Int      @default(0) // total jetons spent
  animationType String?
  displayArea   String?
  createdAt     DateTime @default(now())

  @@index([contextId, createdAt])
  @@index([senderId, createdAt])
  @@index([receiverId, createdAt])
  @@index([giftTypeId, createdAt])
  @@map("gift_history")
}

