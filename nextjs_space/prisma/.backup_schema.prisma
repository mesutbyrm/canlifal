}

// ─── Remote Config ───
// Seviye eşikleri, PK süreleri, ödüller, UI ayarları vb. backend tarafından sunulur.
model RemoteConfig {
  id          String   @id @default(cuid())
  key         String   @unique // örn: level_thresholds, pk_durations, gift_values
  value       Json // JSON değer (dizi, nesne, sayı...)
  valueType   String   @default("json") // json | string | number | boolean
  group       String   @default("general") // gruplama: general, gifts, pk, levels, rooms, live
  description String?
  platform    String   @default("all")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
  @@index([group])
  @@map("remote_configs")
}

// Generic Idempotency-Key store for mutating endpoints (payments, withdrawals).
// A completed record replays its stored response for 24h; see lib/idempotency.ts
model IdempotencyRecord {
  id             String   @id @default(cuid())
  key            String   @unique // "<scope>:<userId>:<client key>"
  scope          String // withdrawal | payment_request | ...
  userId         String?
  status         String   @default("in_flight") // in_flight | completed
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@index([scope])
  @@index([userId])
  @@index([expiresAt])
  @@map("idempotency_records")
}

// ─── IMMUTABLE LEDGER ───
// Double-entry bookkeeping. Every financial movement creates exactly two entries
// (debit + credit) sharing the same transactionId. Rows are append-only — never
// UPDATE or DELETE. balanceAfter is the running balance per account at the time.
model LedgerEntry {
  id            String   @id @default(cuid())
  transactionId String // groups debit+credit pair (or N entries in multi-leg)
  accountType   String // "user_jeton", "user_cfc", "platform_jeton", "platform_cfc", "agency_jeton", "teller_earning"
  accountId     String // userId, agencyId, or "PLATFORM"
  direction     String // "debit" or "credit"
  amount        Int // always positive; direction indicates sign
  currency      String   @default("jeton") // "jeton", "cfc", "tl"
  balanceBefore Int      @default(0)
  balanceAfter  Int      @default(0)
  category      String // "gift_send", "gift_receive", "withdrawal", "purchase", "fortune_session", "daily_bonus", "commission", "admin_adjust", "refund", "game", "room_create", "song_request", "tip", "membership"
  description   String?
  referenceType String? // "GiftEvent", "WithdrawalRequest", "Payment", "LiveSession", etc.
  referenceId   String? // ID of the source record
  metadata      Json? // extra context (giftName, roomId, etc.)
  actorId       String? // who triggered it (userId or adminId)
  createdAt     DateTime @default(now())

  @@index([transactionId])
  @@index([accountType, accountId])
  @@index([accountId, createdAt])
  @@index([category])
  @@index([referenceType, referenceId])
  @@index([createdAt])
  @@map("ledger_entries")
}

// ─── AUDIT LOG ───
// Captures admin/system actions for accountability. Immutable (append-only).
model AuditLog {
  id          String   @id @default(cuid())
  actorId     String // userId of the admin/system performing the action
  actorRole   String? // "admin", "yonetici", "moderator", "finans", "system"
  actorIp     String?
  action      String // "user_ban", "balance_adjust", "withdrawal_approve", "payment_approve", "gift_create", "config_change", "feature_toggle", etc.
  targetType  String? // "User", "WithdrawalRequest", "Payment", "FeatureFlag", etc.
  targetId    String? // ID of the affected record
  before      Json? // state before the change (relevant fields only)
  after       Json? // state after the change
  description String?  @db.Text
  metadata    Json? // extra context
  createdAt   DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────
// RBAC — Role / Permission (Phase 6)
// Additive: existing hardcoded string role checks keep working.
// This layer runs in parallel and lets admins manage permissions in DB.
// ─────────────────────────────────────────────────────────────

model Role {
  id          String   @id @default(cuid())
  key         String   @unique // 'admin' | 'yonetici' | 'moderator' | 'finans' | custom
  name        String
  description String?
  level       Int      @default(0) // higher = more privileged
  isSystem    Boolean  @default(false) // system roles cannot be deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]

  @@index([level])
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. 'finance.withdrawal.approve'
  name        String
  description String?
  group       String? // 'finance' | 'content' | 'moderation' | 'system'
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@index([group])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ===== PHASE 7: Support, Verification, Team, Supporter, Effect Rules =====
// All additive. Following project convention: user links are plain String ids
// (no Prisma relation to the large User model) to keep changes isolated.

// F7: Per-user permission overrides — granular admin permissions per user
model UserPermissionOverride {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionKey String // e.g. 'finance.balance.adjust'
  granted       Boolean  @default(true) // true=grant, false=deny
  grantedBy     String // admin userId
  reason        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, permissionKey])
  @@index([userId])
  @@map("user_permission_overrides")
}

// F7: Admin action log for user management operations
model AdminUserAction {
  id           String   @id @default(cuid())
  targetUserId String
  targetUser   User     @relation("AdminActionTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  adminId      String // admin who performed the action
  adminName    String? // admin display name snapshot
  action       String // jeton_adjust, cfc_adjust, gold_grant, gold_revoke, ban, unban, role_change, permission_change, broadcast_toggle, room_toggle, etc.
  oldValue     String? // JSON serialized old state
  newValue     String? // JSON serialized new state
  reason       String?
  metadata     String?  @db.Text // JSON extra data
  createdAt    DateTime @default(now())

  @@index([targetUserId])
  @@index([adminId])
  @@index([action])
  @@index([createdAt])
  @@map("admin_user_actions")
}

model SupportTicket {
  id            String   @id @default(cuid())
  userId        String // opener
  subject       String
  category      String   @default("general") // general | payment | account | technical | abuse
  status        String   @default("open") // open | pending | resolved | closed
  priority      String   @default("normal") // low | normal | high | urgent
  assignedTo    String? // admin userId handling the ticket
  lastMessageAt DateTime @default(now())
  relatedType   String? // PaymentNotification | CfcPaymentRequest | Withdrawal ...
  relatedId     String? // id of the related record (e.g. payment notification id)
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  messages SupportMessage[]

  @@index([userId])
  @@index([status])
  @@index([assignedTo])
  @@index([category])
  @@index([lastMessageAt])
  @@index([relatedType, relatedId])
  @@map("support_tickets")
}

model SupportMessage {
  id          String   @id @default(cuid())
  ticketId    String
  senderId    String // userId (customer or admin)
  senderRole  String   @default("user") // user | admin | system
  body        String   @db.Text
  isInternal  Boolean  @default(false) // internal admin note, hidden from user
  attachments Json? // array of cloud_storage_path
  createdAt   DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([senderId])
  @@index([createdAt])
  @@map("support_messages")
}

model Verification {
  id           String    @id @default(cuid())
  userId       String
  type         String    @default("identity") // identity | broadcaster | agency
  status       String    @default("pending") // pending | approved | rejected
  fullName     String?
  documentType String? // id_card | passport | driver_license
  documentUrls Json? // array of cloud_storage_path
  note         String?   @db.Text // applicant note
  reviewNote   String?   @db.Text // reviewer note
  reviewedBy   String? // admin userId
  reviewedAt   DateTime?
  metadata     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([reviewedBy])
  @@index([createdAt])
  @@map("verifications")
}

model Team {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  ownerId     String // userId of team owner
  description String?  @db.Text
  logoUrl     String?
  memberCount Int      @default(1)
  totalPoints Int      @default(0)
  isActive    Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members TeamMember[]

  @@index([ownerId])
  @@index([isActive])
  @@index([totalPoints])
  @@map("teams")
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  role     String   @default("member") // owner | admin | member
  points   Int      @default(0)
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

model SupporterLevel {
  id                String    @id @default(cuid())
  userId            String // the supporter (fan)
  broadcasterId     String // the supported broadcaster/teller
  totalContributed  Int       @default(0) // cumulative jeton value contributed
  level             Int       @default(0)
  levelName         String? // "Bronze", "Silver", "Gold", ...
  lastContributedAt DateTime?
  metadata          Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([userId, broadcasterId])
  @@index([broadcasterId, totalContributed])
  @@index([userId])
  @@index([level])
  @@map("supporter_levels")
}

model EffectRule {
  id             String   @id @default(cuid())
  key            String   @unique
  name           String
  description    String?
  effectType     String // entrance | name_effect | chat_bubble | mic_frame | badge | avatar_accessory
  effectRefId    String? // id of the cosmetic item granted
  conditionType  String // level | supporter_level | membership | spend_threshold | manual
  threshold      Int      @default(0) // numeric threshold for the condition
  conditionValue String? // string condition (e.g. membership tier key)
  isActive       Boolean  @default(true)
  priority       Int      @default(0) // higher wins when multiple rules match
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([effectType])
  @@index([conditionType])
  @@index([isActive])
  @@map("effect_rules")
}

// ─── Faz 9: Anti-Fraud / Risk Skorlama ───
// Salt-ekleme (append-only) risk olay kaydı. Mevcut para akışlarını DEĞİŞTİRMEZ;
// yalnızca gözlem amaçlı skor üretir ve admin denetimine sunar.
model RiskEvent {
  id            String    @id @default(cuid())
  userId        String
  category      String // withdrawal | payment_request | gift_send | membership | login
  score         Int       @default(0) // 0-100
  level         String // low | medium | high | critical
  signals       Json? // [{ key, weight, detail }]
  amount        Float?
  currency      String? // jeton | cfc | tl
  referenceType String?
  referenceId   String?
  ip            String?
  reviewed      Boolean   @default(false)
  reviewedBy    String?
  reviewedAt    DateTime?
  reviewNote    String?   @db.Text
  metadata      Json?
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([category])
  @@index([level])
  @@index([reviewed])
  @@index([createdAt])
  @@map("risk_events")
}

/// Faz 15 — WebRTC Telemetri (§76) ve Gözlemlenebilirlik (§74)
/// Salt-ekleme (append-only) ölçüm kaydı. Hiçbir medya akışına veya sinyalleşme
/// davranışına müdahale etmez; yalnızca istemcinin bildirdiği bağlantı kalite
/// metriklerini saklar. Kişisel içerik (ses/görüntü) ASLA saklanmaz.
model RtcTelemetry {
  id String @id @default(cuid())

  /// Ölçümü bildiren kullanıcı (ilişki kurulmadı — şema karmaşası önlenir)
  userId String

  /// Bağlam: 'live_session' | 'voice_room' | 'video_stream' | 'pk'
  context String

  /// İlgili oturum/oda/yayın kimliği (serbest metin)
  contextId String?

  /// Karşı taraf kullanıcı kimliği (varsa)
  peerId String?

  /// WebRTC durumları
  connectionState String? // new|connecting|connected|disconnected|failed|closed
  iceState        String? // new|checking|connected|completed|disconnected|failed|closed

  /// Sayısal kalite metrikleri
  reconnectCount    Int    @default(0)
  rttMs             Float?
  packetLossPercent Float?
  jitterMs          Float?
  bitrateKbps       Float?
  freezeCount       Int    @default(0)
  freezeDurationMs  Int    @default(0)
  durationSeconds   Int    @default(0)

  /// Türetilmiş kalite: 0-100 skor ve seviye (excellent|good|fair|poor|critical)
  qualityScore Int?
  qualityLevel String?

  /// Ortam bilgisi (privacy-safe: IP saklanmaz)
  platform    String? // web|android|ios
  networkType String? // wifi|cellular|ethernet|unknown

  /// Ham istatistik özeti (isteğe bağlı, küçük tutulmalı)
  metadata Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([context])
  @@index([contextId])
  @@index([qualityLevel])
  @@index([createdAt])
  @@map("rtc_telemetry")
}

// ============================================================
// MERKEZI ANIMASYON SISTEMI (Central Animation System)
// Additive: legacy cosmetic models (EntranceEffect, NameEffect,
// ProfileFrame, ChatBubbleSkin, MicFrame, AvatarAccessory,
// MembershipBadge) remain untouched and are bridged via
// legacyType / legacyRefId.
// ============================================================

model Animation {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  category        String // entrance|exit|seat|profile|profile_frame|avatar|microphone|host|gift|level_up|vip|system|page_transition
  type            String // lottie|svga|gif|video|image|apng
  assetUrl        String
  thumbnailUrl    String?
  previewUrl      String?
  soundUrl        String?
  durationMs      Int       @default(3000)
  priority        Int       @default(10)
  status          String    @default("active") // active|inactive|scheduled|archived
  rarity          String    @default("normal") // normal|rare|epic|legendary
  membershipLevel String? // basic|silver|gold|premium|platinum|diamond|vip|svip|admin
  contexts        Json? // ["voice_room","live_stream","social",...]
  position        String    @default("center") // top_left|top_center|top_right|center|bottom_left|bottom_right|seat
  scale           String    @default("medium") // small|medium|large
  anchor          String    @default("room") // room|user|seat|host
  cooldownMs      Int       @default(0)
  canSkip         Boolean   @default(true)
  activeFrom      DateTime?
  activeTo        DateTime?
  legacyType      String? // entrance_effect|name_effect|profile_frame|chat_bubble|mic_frame|avatar_accessory|membership_badge
  legacyRefId     String?
  sortOrder       Int       @default(0)
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  assignments        AnimationAssignment[]
  membershipDefaults AnimationMembershipDefault[]
  playbackLogs       AnimationPlaybackLog[]

  @@index([category, status])
  @@index([membershipLevel])
  @@index([status, priority])
  @@index([legacyType, legacyRefId])
  @@map("animations")
}

model AnimationAssignment {
  id             String    @id @default(cuid())
  userId         String
  animationId    String
  assignmentType String    @default("user_custom") // admin_custom|user_custom|event_reward|purchase
  context        String? // optional context restriction
  category       String? // denormalized for fast filtering
  startDate      DateTime?
  endDate        DateTime?
  priority       Int       @default(50)
  isActive       Boolean   @default(true)
  assignedBy     String?
  note           String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user      User      @relation("AnimationAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  assigner  User?     @relation("AnimationAssignmentAssigner", fields: [assignedBy], references: [id], onDelete: SetNull)
  animation Animation @relation(fields: [animationId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([animationId])
  @@index([endDate])
  @@index([userId, category, isActive])
  @@map("animation_assignments")
}

model AnimationMembershipDefault {
  id             String   @id @default(cuid())
  membershipTier String // basic|silver|gold|premium|platinum|diamond|vip|svip
  category       String
  animationId    String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  animation Animation @relation(fields: [animationId], references: [id], onDelete: Cascade)

  @@unique([membershipTier, category])
  @@index([animationId])
  @@map("animation_membership_defaults")
}

model AnimationPlaybackLog {
  id          String   @id @default(cuid())
  userId      String?
  animationId String
  roomId      String?
  context     String?
  playedAt    DateTime @default(now())

  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  animation Animation @relation(fields: [animationId], references: [id], onDelete: Cascade)

  @@index([animationId, playedAt])
  @@index([userId, playedAt])
  @@map("animation_playback_logs")
}

// ============================================================
// BOLUM 5 - Reklam Yerlesimleri (Ad Placements)
// Additive: mevcut AdNetwork modeli ve /api/ads/active bozulmadi.
// ============================================================

model AdPlacement {
  id           String   @id @default(cuid())
  placementKey String   @unique // home_banner, fortune_interstitial, chat_room_banner ...
  name         String // Turkce gorunen isim
  description  String?  @db.Text
  adNetworkId  String? // null ise genel aktif ag kullanilir
  adType       String   @default("banner") // banner, interstitial, rewarded, native, pre_roll
  position     String? // top, bottom, inline, overlay
  platform     String   @default("all") // all, web, mobile
  isActive     Boolean  @default(false)
  sortOrder    Int      @default(0)
  customCode   String?  @db.Text
  targeting    Json? // { membershipTiers: [], hideForMembership: [], minLevel: n }
  frequencyCap Int      @default(0) // 0 = sinirsiz, gunluk gosterim limiti
  impressions  Int      @default(0)
  clicks       Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  adNetwork AdNetwork? @relation(fields: [adNetworkId], references: [id], onDelete: SetNull)

  @@index([isActive, sortOrder])
  @@index([adType])
  @@index([adNetworkId])
  @@map("ad_placements")
}

// ── BÖLÜM 6: Referans & Ajans komisyon defteri ──
model ReferralCommission {
  id             String   @id @default(cuid())
  earnerId       String // komisyonu kazanan kullanıcı
  sourceUserId   String // jeton yükleyen kullanıcı
  agencyId       String? // ajans komisyonu ise ilgili ajans
  commissionType String   @default("referral") // referral | agency_invite
  topupAmount    Int // yüklenen miktar
  topupCurrency  String   @default("credits") // credits | jeton | cfc
  rate           Float // uygulanan yüzde
  amount         Int // kazanılan miktar
  currency       String   @default("credits")
  sourceType     String   @default("admin_credit") // admin_credit | cfc_payment
  sourceId       String?
  note           String?
  createdAt      DateTime @default(now())
  earner         User     @relation("CommissionEarner", fields: [earnerId], references: [id], onDelete: Cascade)
  sourceUser     User     @relation("CommissionSource", fields: [sourceUserId], references: [id], onDelete: Cascade)

  @@index([earnerId, createdAt])
  @@index([sourceUserId])
  @@index([agencyId, createdAt])
  @@index([commissionType])
  @@index([createdAt])
  @@map("referral_commissions")
}

// ─────────────────────────────────────────────────────────────
// BÖLÜM 6b — Kademeli yükleme bonusu
// Belirli tutarın üzerindeki yüklemelere yüzdelik ek bakiye verir.
// Örn: 10.000 ve üzeri yüklemelere %5, 50.000 ve üzerine %10.
// ─────────────────────────────────────────────────────────────
model TopupBonusTier {
  id           String   @id @default(cuid())
  label        String?
  minAmount    Int
  bonusPercent Float    @default(0)
  currency     String   @default("all") // all | jeton | cfc
  sourceType   String   @default("all") // all | admin_credit | cfc_payment | package
  maxBonus     Int      @default(0) // 0 = sınırsız
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, minAmount])
  @@index([currency])
  @@map("topup_bonus_tiers")
}

// ─────────────────────────────────────────────────────────────
// F4: Saatlik / Günlük Top-100 Leaderboard Sistemi
// ─────────────────────────────────────────────────────────────

// Admin tarafından yapılandırılabilir leaderboard tanımları.
// Her bir (scope, periodType) çifti için ayrı konfigürasyon.
model LeaderboardConfig {
  id         String  @id @default(cuid())
  scope      String // voice_room | live_stream
  periodType String // hourly | daily | weekly | monthly | event
  isEnabled  Boolean @default(true)
  topN       Int     @default(100) // gösterilecek max sıralama

  // Ödül ayarları (JSON: [{rank:1, rewardType:'gold', rewardValue:'30', label:'1 Aylık Gold'}, ...])
  rewardConfig Json?

  // Hangi skorlama kaynakları aktif (JSON: {gift_received:true, gift_sent:false, pk_score:true, viewer_count:false, ...})
  scoringRules Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  periods LeaderboardPeriod[]

  @@unique([scope, periodType])
  @@map("leaderboard_configs")
}

// Her dönem periyodu için bir kayıt (saatlik / günlük vs.)
model LeaderboardPeriod {
  id          String            @id @default(cuid())
  configId    String
  config      LeaderboardConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  scope       String // denormalized for fast query
  periodType  String // denormalized
  periodKey   String // "2026-09-09T14" (hourly), "2026-09-09" (daily), "2026-W37" (weekly), "2026-09" (monthly)
  startTime   DateTime
  endTime     DateTime
  status      String            @default("active") // active | finalized | rewarded
  finalizedAt DateTime?
  rewardedAt  DateTime?

  entries LeaderboardEntry[]
  rewards LeaderboardReward[]

  @@unique([configId, periodKey])
  @@index([scope, periodType, status])
  @@index([endTime, status])
  @@map("leaderboard_periods")
}

// Bir kullanıcının bir periyottaki skoru ve sırası
model LeaderboardEntry {
  id        String            @id @default(cuid())
  periodId  String
  period    LeaderboardPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  contextId String? // roomId veya streamId (hangi oda/yayında kazanıldı)
  score     Int               @default(0)
  rank      Int? // finalize sırasında hesaplanır
  updatedAt DateTime          @updatedAt

  @@unique([periodId, userId])
  @@index([periodId, score])
  @@index([userId])
  @@map("leaderboard_entries")
}

// Dağıtılan ödüller (idempotent — her (periodId, rank) çifti tek kayıt)
model LeaderboardReward {
  id            String            @id @default(cuid())
  periodId      String
  period        LeaderboardPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  rank          Int
  rewardType    String // gold | cfc | jeton | badge | entrance_effect | custom
  rewardValue   String // "30" (gün), "500" (CFC miktarı), badge ID, vs.
  rewardLabel   String? // "1 Aylık Gold"
  status        String            @default("pending") // pending | distributed | failed
  distributedAt DateTime?
  transactionId String? // CreditTransaction ID (varsa)
  createdAt     DateTime          @default(now())

  @@unique([periodId, rank])
  @@index([userId])
  @@map("leaderboard_rewards")
}

// F5: Global Gold online-entrance event feed (USER_ONLINE).
// Emitted once per online session (deduped) when a premium/Gold user comes online.
// Site clients poll /api/presence/online-events and dedup by id to play the card once.
model UserOnlineEvent {
  id            String   @id @default(cuid())
  userId        String
  username      String
  avatarUrl     String?
  effectId      String? // EntranceEffect id used (optional)
  effectUrl     String? // resolved asset url (lottie/svga/gif/video/image)
  effectType    String? // lottie | svga | gif | video | image
  durationMs    Int      @default(4000)
  animationType String   @default("slide_lr") // slide_lr | fade | zoom
  tier          String   @default("gold")
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("user_online_events")
}

// ─────────────────────────────────────────────────────────────────────────────
// BÖLÜM 14 — Mobil (Flutter) entegrasyonu için eklenen modeller.
// Hepsi ADDITIVE'dir; mevcut tablolara dokunmaz, mevcut davranışı değiştirmez.
// ─────────────────────────────────────────────────────────────────────────────

/// Tekil olarak iptal edilmiş (revoke) mobil JWT'ler. tokenHash = sha256(token).
model RevokedToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  tokenType String   @default("access") // access | refresh
  reason    String?
  expiresAt DateTime // token'ın kendi exp'i — bu tarihten sonra kayıt temizlenebilir
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("revoked_tokens")
}

/// "Tüm cihazlardan çıkış": bu tarihten ÖNCE üretilmiş tüm token'lar geçersiz.
model UserTokenRevocation {
  userId    String   @id
  revokedAt DateTime @default(now())
  reason    String?
  updatedAt DateTime @updatedAt

  @@map("user_token_revocations")
}

/// Google Play / App Store satın alma doğrulama kayıtları (idempotent).
model StorePurchase {
  id            String    @id @default(cuid())
  userId        String
  provider      String    @default("google_play") // google_play | app_store
  productId     String
  purchaseToken String
  orderId       String?
  status        String    @default("pending") // pending | verified | granted | failed | duplicate | refunded
  failureReason String?
  rawResponse   Json?
  grantedType   String? // jeton | cfc | membership
  grantedAmount Int       @default(0)
  ledgerTxId    String?
  verifiedAt    DateTime?
  grantedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([provider, purchaseToken])
  @@index([userId])
  @@index([status])
  @@map("store_purchases")
}

/// E-posta doğrulama jetonu (kayıt sonrası e-posta doğrulama akışı).
model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("email_verification_tokens")
}

/// Telefon/SMS tek-kullanımlık doğrulama kodu (OTP).
model PhoneOtp {
  id             String   @id @default(cuid())
  userId         String
  phone          String
  /// KULLANIM DIŞI: düz metin OTP artık yazılmaz. Geriye dönük uyumluluk için tutuluyor.
  code           String?
  /// HMAC-SHA256(kod) — doğrulama yalnızca bu alan üzerinden yapılır.
  codeHash       String?
  expiresAt      DateTime
  used           Boolean  @default(false)
  attempts       Int      @default(0)
  ip             String?
  deviceId       String?
  providerKey    String?
  idempotencyKey String?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([phone])
  @@index([idempotencyKey])
  @@map("phone_otps")
}

/// Kullanıcı tarafı iade talebi (Stripe ödemesi veya mağaza içi satın alma için).
model RefundRequest {
  id              String    @id @default(cuid())
  userId          String
  paymentId       String?
  storePurchaseId String?
  amount          Float
  currency        String    @default("TRY")
  reason          String    @db.Text
  status          String    @default("pending") // pending | approved | rejected | processed
  adminNote       String?   @db.Text
  resolvedBy      String?
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("refund_requests")
}

/// Hesap silme (KVKK / Google Play zorunluluğu) denetim kaydı.
model AccountDeletion {
  id               String    @id @default(cuid())
  userId           String    @unique
  originalEmail    String?
  originalUsername String?
  reason           String?
  source           String    @default("mobile") // mobile | web | admin
  status           String    @default("completed") // completed | failed
  requestedAt      DateTime  @default(now())
  completedAt      DateTime?

  @@index([status])
  @@map("account_deletions")
}

// ─────────────────────────────────────────────────────────────
// Entegrasyon / Secret Management (BÖLÜM 18)
// Tüm hassas değerler AES-256-GCM ile şifreli saklanır; şifreleme
// anahtarı veritabanında DEĞİL, ortam değişkeninde tutulur.
// ─────────────────────────────────────────────────────────────

/// Şifrelenmiş entegrasyon secret'ları. Düz metin ASLA saklanmaz.
model IntegrationSecret {
  id          String   @id @default(cuid())
  scope       String // 'sms' | 'apple' | 'google_play'
  providerKey String // 'netgsm' | 'apple_iap' | 'google_play' ...
  fieldKey    String // 'password' | 'api_key' | 'service_account_json' ...
  ciphertext  String   @db.Text
  iv          String
  authTag     String
  keyVersion  Int      @default(1)
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([scope, providerKey, fieldKey])
  @@index([scope])
  @@map("integration_secrets")
}

/// SMS sağlayıcı kaydı (aktif/pasif + öncelik).
model SmsProvider {
  id          String   @id @default(cuid())
  providerKey String   @unique
  displayName String
  enabled     Boolean  @default(false)
  priority    Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled, priority])
  @@map("sms_providers")
}

/// SMS sağlayıcısının HASSAS OLMAYAN ayarları (başlık, bölge, base url vb.).
model SmsProviderConfig {
  id          String   @id @default(cuid())
  providerKey String
  fieldKey    String
  value       String   @db.Text
  updatedAt   DateTime @updatedAt

  @@unique([providerKey, fieldKey])
  @@map("sms_provider_configs")
}

/// SMS sağlayıcı sağlık/telemetri durumu.
model SmsProviderHealth {
  id               String    @id @default(cuid())
  providerKey      String    @unique
  status           String    @default("unknown") // healthy | degraded | disabled | unknown
  lastSuccessAt    DateTime?
  lastFailureAt    DateTime?
  lastTestedAt     DateTime?
  lastUsedAt       DateTime?
  lastError        String?   @db.Text
  successCount     Int       @default(0)
  failureCount     Int       @default(0)
  fallbackUseCount Int       @default(0)
  avgLatencyMs     Int       @default(0)
  cooldownUntil    DateTime?
  updatedAt        DateTime  @updatedAt

  @@map("sms_provider_health")
}

/// SMS gönderim denemesi kaydı. OTP kodu ve mesaj içeriği ASLA yazılmaz.
model SmsDeliveryLog {
  id                String   @id @default(cuid())
  providerKey       String
  phoneMasked       String
  purpose           String   @default("otp")
  success           Boolean
  errorCode         String?
  latencyMs         Int?
  isFallback        Boolean  @default(false)
  isTest            Boolean  @default(false)
  idempotencyKey    String?
  providerMessageId String?
  createdAt         DateTime @default(now())

  @@index([providerKey, createdAt])
  @@index([idempotencyKey])
  @@map("sms_delivery_logs")
}

/// Entegrasyonlara ait HASSAS OLMAYAN genel ayarlar (seçim modu, eşikler vb.).
model IntegrationSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("integration_settings")
}

// ═══════════════════════════════════════════════════════════════
// BÖLÜM 20 — ÜYELİK / VIP YETENEK (CAPABILITY) SİSTEMİ
// Tamamen admin panelinden yönetilebilir. Jeton ekonomisine DOKUNMAZ.
// ═══════════════════════════════════════════════════════════════

/// Üyelik kademeleri kataloğu (basic, gold, premium, diamond, svip, ...)
model MembershipTierDef {
  id              String   @id @default(cuid())
  key             String   @unique // basic | gold | premium | diamond | svip
  name            String // Görünen ad (TR)
  nameEn          String   @default("")
  rank            Int      @default(0) // sıralama/karşılaştırma; büyük = üstün
  color           String   @default("#9ca3af") // rozet/isim rengi
  gradient        String? // CSS gradient (isim efekti)
  icon            String   @default("⭐")
  badgeUrl        String?
  frameUrl        String?
  description     String?  @db.Text
  discoveryWeight Float    @default(1.0) // keşfet/sıralama ağırlığı (§14)
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tierFeatures MembershipTierFeature[]

  @@index([isActive, sortOrder])
  @@index([rank])
  @@map("membership_tier_defs")
}

/// Yetenek (capability) kataloğu — vip.profile_frame, vip.hidden_online, ...
model MembershipFeature {
  id          String   @id @default(cuid())
  key         String   @unique // vip.profile_frame
  name        String
  nameEn      String   @default("")
  category    String   @default("general") // profile | privacy | room | message | discovery | event | support | cosmetic | access
  description String?  @db.Text
  valueType   String   @default("boolean") // boolean | number | string | asset | enum
  unit        String? // adet/gün vb.
  options     Json? // enum seçenekleri
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tierFeatures MembershipTierFeature[]

  @@index([category, sortOrder])
  @@index([isActive])
  @@map("membership_features")
}

/// Kademe × Yetenek matrisi — admin panelinden düzenlenir
model MembershipTierFeature {
  id           String   @id @default(cuid())
  tierKey      String
  featureKey   String
  enabled      Boolean  @default(false)
  limitValue   Int? // genel limit (null = sınırsız)
  dailyLimit   Int?
  monthlyLimit Int?
  durationDays Int? // özelliğin süresi (varsa)
  priority     Int      @default(0) // öncelik seviyesi
  assetRef     String? // görsel/animasyon referansı (id veya url)
  defaultValue Json? // varsayılan değer
  metadata     Json?
  updatedBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tier    MembershipTierDef @relation(fields: [tierKey], references: [key], onDelete: Cascade)
  feature MembershipFeature @relation(fields: [featureKey], references: [key], onDelete: Cascade)

  @@unique([tierKey, featureKey])
  @@index([featureKey])
  @@index([tierKey, enabled])
  @@map("membership_tier_features")
}

/// Kullanıcı VIP gizlilik/görünürlük tercihleri (§9, §11)
model UserVipPreference {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hideVipBadge           Boolean  @default(false)
  hideOnlineStatus       Boolean  @default(false)
  hideLastSeen           Boolean  @default(false)
  hideProfileVisit       Boolean  @default(false) // profilleri gizli gez
  hiddenRoomEntry        Boolean  @default(false) // odaya gizli gir
  hideVipStatus          Boolean  @default(false)
  disableEntranceEffects Boolean  @default(false) // kendi giriş efektini kapat
  muteOthersEntrance     Boolean  @default(false) // başkalarının efektlerini görme
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("user_vip_preferences")
}

/// Profil ziyaretçileri (§5 Premium+)
model ProfileVisit {
  id        String   @id @default(cuid())
  visitorId String
  profileId String
  isHidden  Boolean  @default(false) // ziyaretçi gizli geziyorsa
  visitedAt DateTime @default(now())

  visitor User @relation("ProfileVisitVisitor", fields: [visitorId], references: [id], onDelete: Cascade)
  profile User @relation("ProfileVisitTarget", fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([visitorId, profileId])
  @@index([profileId, visitedAt])
  @@index([visitorId, visitedAt])
  @@map("profile_visits")
}

/// Üyelik geçmişi + hediye üyelik altyapısı (§19, §20)
model MembershipGrant {
  id            String    @id @default(cuid())
  receiverId    String
  giverId       String? // hediye eden (null = satın alma / admin)
  tierKey       String
  previousTier  String?
  source        String    @default("purchase") // purchase | gift | admin | renewal | migration
  startsAt      DateTime  @default(now())
  expiresAt     DateTime?
  transactionId String? // ödeme/mağaza işlem referansı
  status        String    @default("active") // active | expired | cancelled | pending
  autoRenew     Boolean   @default(false)
  note          String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  receiver User  @relation("MembershipGrantReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  giver    User? @relation("MembershipGrantGiver", fields: [giverId], references: [id], onDelete: SetNull)

  @@index([receiverId, status])
  @@index([giverId])
  @@index([status, expiresAt])
  @@index([tierKey])
  @@index([transactionId])
  @@map("membership_grants")
}

/// VIP XP defteri (§18) — jeton/CFC ekonomisinden TAMAMEN ayrı
model VipXpLedger {
  id           String   @id @default(cuid())
  userId       String
  amount       Int
  source       String // login | voice_room | event | social | stream | achievement | admin
  refId        String?
  note         String?
  balanceAfter Int      @default(0)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([source])
  @@map("vip_xp_ledger")
}

/// Kademeye özel etkinlikler (§17, §19 etkinlik takvimi) — yönetici panelinden oluşturulur
model MembershipEvent {
  id           String   @id @default(cuid())
  title        String
  description  String?  @db.Text
  bannerUrl    String?
  ctaUrl       String?
  startsAt     DateTime
  endsAt       DateTime
  minTierKey   String? // bu kademe ve üstü görebilir
  allowedTiers String[] @default([]) // boşsa minTierKey kuralı geçerli
  isActive     Boolean  @default(true)
  priority     Int      @default(0)
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, startsAt])
  @@index([endsAt])
  @@map("membership_events")
}


// ─── BÖLÜM 21: kullanıcı uyarıları (§8) ───────────────────
model UserWarning {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation("UserWarningTarget", fields: [userId], references: [id], onDelete: Cascade)
  adminId   String
  adminName String?
  reason    String    @db.Text
  severity  String    @default("info") // info | warning | severe
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("user_warnings")
}

// ─── BÖLÜM 21 §52: kullanıcı zaman çizelgesi ──────────────
model UserTimelineEvent {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String // signup | vip | agency_join | first_stream | first_room | fortune_teller | contest | admin_action | ...
  title       String
  description String?  @db.Text
  metadata    String?  @db.Text // JSON
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([userId, occurredAt])
  @@index([type])
  @@map("user_timeline_events")
}


// ═══════════════════════════════════════════════════════════
// BÖLÜM 21 / A3 — AJANS CÜZDANI VE KOMİSYON YAPILANDIRMASI
// ═══════════════════════════════════════════════════════════

/// Ajans jeton kredisi cüzdanı. Bakiye yalnızca ledger (AgencyWalletTransaction)
/// üzerinden değişir; nakit olarak çekilemez (§14).
model AgencyWallet {
  id               String   @id @default(cuid())
  agencyId         String   @unique
  jetonBalance     Float    @default(0)
  totalTopUp       Float    @default(0) // temel jeton toplamı
  totalBonus       Float    @default(0) // bonus jeton toplamı
  totalTransferred Float    @default(0) // üyelere aktarılan
  totalAdjusted    Float    @default(0) // admin düzeltmeleri (net)
  isLocked         Boolean  @default(false)
  lockReason       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  agency           Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@map("agency_wallets")
}

/// Değiştirilemez ajans muhasebe kaydı (§17). Satırlar asla güncellenmez;
/// düzeltme her zaman yeni bir satır olarak eklenir.
model AgencyWalletTransaction {
  id             String   @id @default(cuid())
  agencyId       String
  type           String // topup, bonus, transfer, adjust_credit, adjust_debit
  direction      String // credit | debit
  amount         Float
  balanceBefore  Float
  balanceAfter   Float
  tlAmount       Float? // yükleme işlemlerinde ödenen TL
  rateUsed       Float? // TL → jeton kuru
  bonusRate      Float? // uygulanan bonus yüzdesi
  targetUserId   String?
  targetUserName String?
  actorId        String?
  actorName      String?
  actorRole      String?
  reason         String?
  referenceType  String?
  referenceId    String?
  idempotencyKey String?
  metadata       String? // JSON
  createdAt      DateTime @default(now())
  agency         Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId, createdAt])
  @@index([type])
  @@index([targetUserId])
  @@index([idempotencyKey])
  @@map("agency_wallet_transactions")
}

/// Gelir kaynağı bazlı ajans komisyon kuralı (§18).
/// agencyId null ⇒ global varsayılan kural.
model AgencyCommissionRule {
  id            String   @id @default(cuid())
  agencyId      String?
  sourceType    String // stream_gift, chat_gift, direct_gift, tip, fortune, voice_room
  enabled       Boolean  @default(true)
  rate          Float? // null ⇒ ajansın kendi commissionRate değeri kullanılır
  note          String?
  updatedById   String?
  updatedByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  agency        Agency?  @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId, sourceType])
  @@index([sourceType])
  @@map("agency_commission_rules")
}

/// Ajans seviyesine göre bonus oranı (§16). Admin panelinden düzenlenir.
model AgencyBonusRule {
  id                    String   @id @default(cuid())
  level                 String   @unique // bronze, silver, gold, diamond
  label                 String
  bonusRate             Float    @default(0) // yüzde
  minMonthlyEarning     Float    @default(0)
  minActiveBroadcasters Int      @default(0)
  minStreamMinutes      Int      @default(0)
  isActive              Boolean  @default(true)
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("agency_bonus_rules")
}

// ─── CFC ARENA: Yarışma / Contest Sistemi (BÖLÜM 21/A5) ───

model CfcContest {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  description       String?
  type              String   // individual, broadcaster, agency, room, team, duel, league, elimination, top100
  scope             String   @default("general") // general, weekly, daily, monthly, seasonal
  status            String   @default("draft")   // draft, scheduled, active, paused, frozen, completed, cancelled
  seasonId          String?
  season            CfcSeason? @relation(fields: [seasonId], references: [id])

  // Scoring
  scoringMetrics    String   // JSON: [{metric, weight, label}]  e.g. stream_minutes, gifts_received, viewer_count...
  commissionRate    Float?   // override platform commission during contest (null = no change)
  
  // Rules
  rules             String?  // JSON: freeform rules text
  minParticipants   Int      @default(2)
  maxParticipants   Int?
  entryRequirements String?  // JSON: {minLevel, minAge, mustBeStreamer, mustBeInAgency, ...}
  
  // Dates
  startsAt          DateTime?
  endsAt            DateTime?
  registrationEndsAt DateTime?
  
  // Rewards (non-monetary)
  rewards           String?  // JSON: [{rank, rewardType, rewardValue, label}] rewardType: badge|title|frame|effect|visibility
  
  // Admin
  createdBy         String?
  isPublic          Boolean  @default(true)
  isFeatured        Boolean  @default(false)
  bannerImage       String?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  participants      CfcParticipant[]
  teams             CfcTeam[]
  scoreLogs         CfcScoreLog[]

  @@index([status])
  @@index([type, status])
  @@index([startsAt])
  @@map("cfc_contests")
}

model CfcSeason {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contests    CfcContest[]

  @@map("cfc_seasons")
}

model CfcTeam {
  id          String   @id @default(cuid())
  contestId   String
  contest     CfcContest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  name        String
  color       String?  // hex
  badgeEmoji  String?
  captainId   String?
  totalScore  Float    @default(0)
  rank        Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     CfcParticipant[]

  @@index([contestId])
  @@map("cfc_teams")
}

model CfcParticipant {
  id          String   @id @default(cuid())
  contestId   String
  contest     CfcContest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  userId      String?
  agencyId    String?  // for agency contests
  roomId      String?  // for room contests
  teamId      String?
  team        CfcTeam? @relation(fields: [teamId], references: [id])
  
  displayName String?
  score       Float    @default(0)
  rank        Int?
  status      String   @default("active") // active, disqualified, withdrawn
  joinedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([contestId, userId])
  @@index([contestId, score])
  @@index([contestId, rank])
  @@map("cfc_participants")
}

model CfcScoreLog {
  id          String   @id @default(cuid())
  contestId   String
  contest     CfcContest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  userId      String?
  agencyId    String?
  roomId      String?
  metric      String   // stream_minutes, gifts_received, viewer_count, activity_points, room_engagement...
  delta       Float
  reason      String?
  calculatedAt DateTime @default(now())

  @@index([contestId, userId])
  @@index([contestId, calculatedAt])
  @@map("cfc_score_logs")
}

// ─── BÖLÜM 21/A6: Tanış & Kaynaş Sosyal Etkileşim ───

model SocialAction {
  id          String   @id @default(cuid())
  actorId     String
  actor       User     @relation("SocialActionActor", fields: [actorId], references: [id], onDelete: Cascade)
  targetId    String
  target      User     @relation("SocialActionTarget", fields: [targetId], references: [id], onDelete: Cascade)
  type        String   // like, favorite, friend_request, friend_accept, block, report
  status      String   @default("active") // active, cancelled, accepted, rejected
  message     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([actorId, targetId, type])
  @@index([targetId, type])
  @@index([actorId, type])
  @@map("social_actions")
}


// ─── BÖLÜM 22/B4: Hediye Kutusu (Gift Box) ───
// Canlı yayın ve sesli sohbet odalarında çalışan ödül kutusu sistemi.
// Kullanıcıya bağlar düz skaler FK olarak tutulur (paylaşımlı şema — additive).

model GiftBox {
  id        String  @id @default(cuid())
  scope     String  @default("stream") // stream | room
  streamId  String?
  roomId    String?
  creatorId String

  totalAmount Int
  winnerCount Int
  durationSec Int
  splits      String // JSON int[] — toplamı daima totalAmount

  taskType         String  @default("none") // none | follow_creator | follow_broadcaster | follow_user | share
  taskTargetUserId String?

  status     String    @default("active") // active | finished | cancelled | expired
  startsAt   DateTime  @default(now())
  endsAt     DateTime
  finishedAt DateTime?
  settledAt  DateTime? // tek seferlik kapanış/iade kilidi
  refundedAmount Int    @default(0)

  paidCount  Int @default(0)
  paidAmount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries GiftBoxEntry[]

  @@index([streamId, status])
  @@index([roomId, status])
  @@index([creatorId])
  @@index([status, endsAt])
  @@map("gift_boxes")
}

model GiftBoxEntry {
  id           String   @id @default(cuid())
  boxId        String
  userId       String
  taskVerified Boolean  @default(false)
  isWinner     Boolean  @default(false)
  rewardAmount Int      @default(0)
  rank         Int?
  joinedAt     DateTime @default(now())

  box GiftBox @relation(fields: [boxId], references: [id], onDelete: Cascade)

  @@unique([boxId, userId])
  @@index([boxId, isWinner])
  @@index([userId])
  @@map("gift_box_entries")
}

// Doğrulanabilir paylaşım olayı (§11-C "Yayını paylaş" görevi için).
model ShareEvent {
  id        String   @id @default(cuid())
  userId    String
  scope     String // stream | room
  targetId  String
  channel   String   @default("link")
  createdAt DateTime @default(now())

  @@index([scope, targetId, userId, createdAt])
  @@index([userId, createdAt])
  @@map("share_events")
}
