// Game configurations managed by admin
model MiniGame {
  id          String   @id @default(cuid())
  slug        String   @unique // fal-carki, tarot-sec, memory, quiz, sans-kutusu, sayi-tahmin
  title       String
  description String?
  icon        String   @default("🎮")
