// Stream moderators (max 10 per stream, can mute users)
model StreamModerator {
  id       String   @id @default(cuid())
  streamId String
  userId   String
  addedAt  DateTime @default(now())

  @@unique([streamId, userId])
  @@index([streamId])
  @@index([userId])
  @@map("stream_moderators")
}

// PK Battle between two streamers (TikTok-style)
model PKBattle {
  id         String    @id @default(cuid())
  stream1Id  String // Challenger stream
  stream2Id  String // Opponent stream
  user1Id    String // Challenger user
  user2Id    String // Opponent user
  score1     Int       @default(0) // Gift points for stream1
  score2     Int       @default(0) // Gift points for stream2
  status     String    @default("pending") // pending, active, completed, cancelled, rejected
  duration   Int       @default(300) // Duration in seconds (default 5 min, admin-configurable)
  startedAt  DateTime?
  endedAt    DateTime?
  winnerId   String? // Winner user ID
  createdAt  DateTime  @default(now())
  // ── Live PK realtime fields (added) ──
  acceptedAt DateTime? // when the opponent accepted
  endsAt     DateTime? // authoritative countdown end (server clock) for synced timers
  isDraw     Boolean   @default(false) // true when scores are equal at finish
  winnerSide Int? // 1 or 2 (null on draw / not finished)
  scoreLogs  PkScore[]
  pkGifts    PkGift[]
  // ── Bölüm 22 / B3: PK genişletme (yalnızca eklemeli) ──
  mode         String    @default("1v1") // 1v1 | 1v2 | 1v3 | 2v2 | team
  scope        String    @default("stream") // stream | room | room_user | guest
  scopeRoomId  String? // aynı oda/yayın içi PK'da odanın kimliği
  pausedAt     DateTime? // duraklatma anı (paused durumunda dolu)
  pausedMs     Int       @default(0) // toplam duraklatılmış süre (ms)
  participants PkBattleParticipant[]

  @@index([stream1Id])
  @@index([stream2Id])
  @@index([user1Id])
  @@index([user2Id])
  @@index([status])
  // Perf: quickly find a live battle for a given stream/user, and expired battles to finalize
  @@index([status, endsAt])
  @@index([scopeRoomId])
  @@map("pk_battles")
}

// ── Bölüm 22 / B3: Çok taraflı PK katılımcıları (1v2, 1v3, takım) ──
// PKBattle'a bağlı canlı katılımcı satırı. PkParticipant (pk_matches tabanlı,
// eski faz) ile KARIŞTIRILMAMALIDIR.
model PkBattleParticipant {
  id         String   @id @default(cuid())
  battleId   String
  side       Int // 1 = sol taraf, 2 = sağ taraf
  userId     String
  seatNumber Int? // sesli odadaki koltuk numarası (varsa)
  points     Int      @default(0) // bu katılımcıya atfedilen puan
  isCaptain  Boolean  @default(false) // tarafın kaptanı (user1Id / user2Id)
  createdAt  DateTime @default(now())
  battle     PKBattle @relation(fields: [battleId], references: [id], onDelete: Cascade)

  @@unique([battleId, userId])
  @@index([battleId, side])
  @@index([userId])
  @@map("pk_battle_participants")
}

// Per-contributor score ledger inside a PK battle (for realtime aggregation & top-supporter).
model PkScore {
  id            String   @id @default(cuid())
  battleId      String
  side          Int // 1 = left/host, 2 = right/opponent
  contributorId String // the viewer who sent the gift that scored these points
  points        Int // gross jeton value added
  source        String   @default("gift") // gift | manual | battle_bonus
  createdAt     DateTime @default(now())
  battle        PKBattle @relation(fields: [battleId], references: [id], onDelete: Cascade)

  @@index([battleId])
  @@index([battleId, side])
  @@index([battleId, contributorId])
  @@map("pk_scores")
}

// Detailed gift log attributed to a PK battle side.
model PkGift {
  id         String   @id @default(cuid())
  battleId   String
  side       Int // 1 or 2 (which side the gift scored for)
  senderId   String // viewer who sent
  receiverId String // the broadcaster on that side
  giftTypeId String
  quantity   Int      @default(1)
  points     Int // gross jeton value (added to that side's score)
  createdAt  DateTime @default(now())
  battle     PKBattle @relation(fields: [battleId], references: [id], onDelete: Cascade)

  @@index([battleId])
  @@index([battleId, side])
  @@index([senderId])
  @@map("pk_gifts")
}

// Active/past multi-guest seats on a live video stream (max 8 guests).
model LiveGuestSession {
