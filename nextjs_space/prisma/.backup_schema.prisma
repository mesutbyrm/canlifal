  cost         Int      @default(0) // Cost in the specified currency
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([currencyType])
  @@map("currency_config")
}

model LiveActivity {
  id           String   @id @default(cuid())
  userId       String? // null for anonymous users
  userName     String // display name (can be anonymous)
  userAvatar   String? // avatar URL
  activityType String // fortune_read, chat_join, dream_shared, stream_started, gift_sent, signup, blog_read, etc.
  detail       String? // e.g. "Tarot Falı baktırdı", "Sohbete katıldı"
  targetUrl    String? // link to related page
  createdAt    DateTime @default(now())

  user User? @relation("userActivities", fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([activityType])
  @@map("live_activities")
}

model ActivityFeedConfig {
  id                 String   @id @default(cuid())
  isEnabled          Boolean  @default(true)
  maxItems           Int      @default(20) // max items to show
  // Visibility - which groups can see
  visibleToGuests    Boolean  @default(true) // kayıtsız kullanıcılar
  visibleToBasic     Boolean  @default(true) // basic üyeler
  visibleToPremium   Boolean  @default(true) // premium üyeler
  visibleToGold      Boolean  @default(true) // gold üyeler
  visibleToDiamond   Boolean  @default(true) // diamond üyeler
  visibleToModerator Boolean  @default(true) // moderatörler
  visibleToAdmin     Boolean  @default(true) // adminler
  // Specific user IDs (comma-separated) - if set, ONLY these users see it
  specificUserIds    String? // comma-separated user IDs
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("activity_feed_config")
}

// ========== AGENCY SYSTEM ==========

model Agency {
  id               String               @id @default(cuid())
  name             String               @unique
  description      String?
  ownerId          String // User who applied
  ownerName        String
  status           String               @default("pending") // pending, approved, rejected, suspended
  commissionRate   Float                @default(5.0) // Agency commission % on member earnings
  contactEmail     String?
  contactPhone     String?
  logoUrl          String?
  // Performance
  totalEarnings    Float                @default(0)
  totalMembers     Int                  @default(0)
  activeMembers    Int                  @default(0)
  performanceScore Float                @default(0) // APS: 0-100
  // Penalty tracking
  penaltyLevel     Int                  @default(0) // 0=clean, 1=warning, 2=invites_disabled, 3=commission_reduced, 4=suspended
  penaltyNote      String?
  invitesDisabled  Boolean              @default(false)
  // BÖLÜM 21 / A3 — seviye (bonus oranı bu seviyeden okunur)
  level            String               @default("bronze") // bronze, silver, gold, diamond
  // Metadata
  approvedAt       DateTime?
  rejectedAt       DateTime?
  rejectedReason   String?
  suspendedAt      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  // Relations
  members          AgencyUser[]
  earnings         AgencyEarning[]
  inviteCodes      InviteCode[]
  tasks            AgencyTask[]
  penalties        AgencyPenalty[]
  leaveRequests    AgencyLeaveRequest[]
  wallet           AgencyWallet?
  walletTxns       AgencyWalletTransaction[]
  commissionRules  AgencyCommissionRule[]

  @@index([ownerId])
  @@index([status])
  @@index([createdAt])
  @@map("agencies")
}

model AgencyUser {
  id            String      @id @default(cuid())
  agencyId      String
  userId        String      @unique // One user can only be in one agency
  role          String      @default("member") // owner, manager, member
  joinedVia     String? // invite_code, referral_link, direct
  inviteCodeId  String?
  totalEarnings Float       @default(0) // Total earnings contributed to agency
  isActive      Boolean     @default(true)
  joinedAt      DateTime    @default(now())
  leftAt        DateTime?
  // Fraud tracking
  joinIp        String?
  joinDeviceId  String?
  agency        Agency      @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  inviteCode    InviteCode? @relation(fields: [inviteCodeId], references: [id])

  @@index([agencyId])
  @@index([userId])
  @@index([isActive])
  @@map("agency_users")
}

model AgencyEarning {
  id             String   @id @default(cuid())
  agencyId       String
  userId         String // The member who generated the earning
  amount         Float // Commission amount earned by agency
  sourceType     String // chat_gift, stream_gift, direct_gift, tip, bonus
  sourceId       String? // Gift/transaction ID
  originalAmount Float // Original gift amount before commission
  commissionRate Float // Rate applied at the time
  createdAt      DateTime @default(now())
  agency         Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId])
  @@index([userId])
  @@index([createdAt])
  @@index([sourceType])
  @@index([agencyId, createdAt])
  @@map("agency_earnings")
}

model InviteCode {
  id          String       @id @default(cuid())
  agencyId    String
  code        String       @unique
  createdById String // User who created the code
  maxUses     Int          @default(0) // 0 = unlimited
  usedCount   Int          @default(0)
  isActive    Boolean      @default(true)
  expiresAt   DateTime?
  createdAt   DateTime     @default(now())
  agency      Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  usedBy      AgencyUser[]

  @@index([agencyId])
  @@index([code])
  @@map("invite_codes")
}

model AgencyTask {
  id                String   @id @default(cuid())
  agencyId          String
  weekStart         DateTime // Monday of the task week
  weekEnd           DateTime // Sunday of the task week
  // Dynamic targets
  earningsTarget    Float    @default(0)
  newUsersTarget    Int      @default(0)
  activeUsersTarget Int      @default(0)
  // Actual values
  earningsActual    Float    @default(0)
  newUsersActual    Int      @default(0)
  activeUsersActual Int      @default(0)
  // Scoring
  completionPercent Float    @default(0)
  bonusAwarded      Float    @default(0)
  status            String   @default("active") // active, completed, failed
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  agency            Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@unique([agencyId, weekStart])
  @@index([agencyId])
  @@index([weekStart])
  @@index([status])
  @@map("agency_tasks")
}

model AgencyPenalty {
  id           String    @id @default(cuid())
  agencyId     String
  level        Int // 1=warning, 2=disable_invites, 3=reduce_commission, 4=suspend
  reason       String
  appliedBy    String? // Admin userId or 'system'
  isActive     Boolean   @default(true)
  resolvedAt   DateTime?
  resolvedBy   String?
  resolvedNote String?
  createdAt    DateTime  @default(now())
  agency       Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId])
  @@index([isActive])
  @@map("agency_penalties")
}

// Ajanstan Çıkma Talepleri
model AgencyLeaveRequest {
  id         String    @id @default(cuid())
  agencyId   String
  userId     String
  reason     String?
  status     String    @default("pending") // pending, approved, rejected
  reviewedBy String? // Agency owner/manager who reviewed
  reviewNote String?
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
  agency     Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([agencyId])
  @@index([userId])
  @@index([status])
  @@map("agency_leave_requests")
}

// Haftalık Turnuva Sistemi
model WeeklyTournament {
  id          String   @id @default(cuid())
  weekStart   DateTime
  weekEnd     DateTime
  type        String   @default("jeton_spend") // jeton_spend, session_count, gift_sent, fortune_count, pk_score, viewer_count, interaction
  title       String
  description String?
  status      String   @default("active") // draft, registration, active, completed, rewarded, cancelled
  rewards     String? // JSON: [{ rank: 1, prize: 500, currency: 'cfc' }, ...]
  createdAt   DateTime @default(now())

  // F3 eklemeli alanlar (mevcut satırlar etkilenmez)
  category          String? // stream, voice, general
  coverImage        String?
  registrationStart DateTime?
  registrationEnd   DateTime?
  minParticipants   Int?
  maxParticipants   Int?
  visibility        String?   @default("public") // public, private, invite_only
  scoringType       String? // cumulative, per_round, bracket
  eliminationType   String? // none, single_elimination, double_elimination, round_robin
  roundCount        Int?      @default(1)
  createdBy         String? // admin userId
  updatedAt         DateTime? @updatedAt
  rewardedAt        DateTime? // ödüller ne zaman dağıtıldı

  entries WeeklyTournamentEntry[]
  rounds  TournamentRound[]

  @@unique([weekStart, type])
  @@index([status])
  @@index([category, status])
  @@map("weekly_tournaments")
}

model WeeklyTournamentEntry {
  id           String   @id @default(cuid())
  tournamentId String
  userId       String
  score        Int      @default(0)
  rank         Int?
  rewarded     Boolean  @default(false)
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  tournament WeeklyTournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
  @@index([tournamentId])
  @@index([userId])
  @@map("weekly_tournament_entries")
}

// Turnuva round'ları (bracket / eleme sistemi)
model TournamentRound {
  id           String    @id @default(cuid())
  tournamentId String
  roundNumber  Int       @default(1)
  name         String? // "Çeyrek Final", "Yarı Final", "Final"
  stage        String? // qualifier, group, semifinal, final
  status       String    @default("pending") // pending, active, completed
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime  @default(now())

  tournament WeeklyTournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matches    TournamentMatch[]

  @@unique([tournamentId, roundNumber])
  @@index([tournamentId])
  @@map("tournament_rounds")
}

// Turnuva maçları (A vs B)
model TournamentMatch {
  id         String    @id @default(cuid())
  roundId    String
  matchOrder Int       @default(1)
  status     String    @default("pending") // pending, active, completed, cancelled
  side1Id    String? // userId veya roomId/streamId
  side1Name  String?
  side1Score Int       @default(0)
  side2Id    String?
  side2Name  String?
  side2Score Int       @default(0)
  winnerId   String?
  startedAt  DateTime?
  endedAt    DateTime?
  pkBattleId String? // ilişkili PKBattle (opsiyonel)
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime? @updatedAt

  round TournamentRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@index([roundId])
  @@index([side1Id])
  @@index([side2Id])
  @@map("tournament_matches")
}

// Favori Falcılar
model FavoriteTeller {
  id        String   @id @default(cuid())
  userId    String
  tellerId  String
  createdAt DateTime @default(now())

  @@unique([userId, tellerId])
  @@index([userId])
  @@index([tellerId])
  @@map("favorite_tellers")
}

// Celebrity profiles for famous people
model Celebrity {
  id            String            @id @default(cuid())
  name          String
  slug          String            @unique
  category      String // oyuncu, sarkici, futbolcu, youtuber, influencer, yonetmen, diger
  bio           String?           @db.Text
  profileImage  String?
  coverImage    String?
  isVerified    Boolean           @default(true)
  isActive      Boolean           @default(true)
  followerCount Int               @default(0)
  birthDate     DateTime?
  birthPlace    String?
  zodiacSign    String?
  socialLinks   String?           @db.Text // JSON: {instagram, twitter, youtube, tiktok, website}
  achievements  String?           @db.Text // JSON array of notable achievements
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  followers     CelebrityFollow[]
  fanClub       FanClub?
  posts         CelebrityPost[]

  @@index([category])
  @@index([isActive])
  @@index([followerCount])
  @@index([slug])
  @@map("celebrities")
}

// User follows on celebrities
model CelebrityFollow {
  id          String    @id @default(cuid())
  userId      String
  celebrityId String
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  celebrity   Celebrity @relation(fields: [celebrityId], references: [id], onDelete: Cascade)

  @@unique([userId, celebrityId])
  @@index([userId])
  @@index([celebrityId])
  @@map("celebrity_follows")
}

// Fan club for a celebrity
model FanClub {
  id          String          @id @default(cuid())
  celebrityId String          @unique
  celebrity   Celebrity       @relation(fields: [celebrityId], references: [id], onDelete: Cascade)
  description String?         @db.Text
  rules       String?         @db.Text // JSON array of rules
  coverImage  String?
  memberCount Int             @default(0)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  members     FanClubMember[]
  posts       FanClubPost[]
  polls       FanClubPoll[]

  @@index([isActive])
  @@map("fan_clubs")
}

// Fan club membership
model FanClubMember {
  id        String   @id @default(cuid())
  fanClubId String
  userId    String
  role      String   @default("member") // member, moderator
  xp        Int      @default(0)
  level     String   @default("yeni_fan") // yeni_fan, aktif_fan, super_fan, vip_fan, efsane_fan
  createdAt DateTime @default(now())
  fanClub   FanClub  @relation(fields: [fanClubId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([fanClubId, userId])
  @@index([fanClubId])
  @@index([userId])
  @@map("fan_club_members")
}

// Fan club polls/surveys (Anket)
model FanClubPoll {
  id        String            @id @default(cuid())
  fanClubId String
  userId    String
  question  String
  options   Json // Array of { text: string }
  isActive  Boolean           @default(true)
  endsAt    DateTime?
  createdAt DateTime          @default(now())
  fanClub   FanClub           @relation(fields: [fanClubId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes     FanClubPollVote[]

  @@index([fanClubId, isActive])
  @@index([userId])
  @@map("fan_club_polls")
}

model FanClubPollVote {
  id          String      @id @default(cuid())
  pollId      String
  userId      String
  optionIndex Int
  createdAt   DateTime    @default(now())
  poll        FanClubPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([pollId])
  @@index([userId])
  @@map("fan_club_poll_votes")
}

// Fan club wall post
model FanClubPost {
  id        String            @id @default(cuid())
  fanClubId String
  userId    String
  content   String            @db.Text
  image     String?
  likeCount Int               @default(0)
  isPinned  Boolean           @default(false)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  fanClub   FanClub           @relation(fields: [fanClubId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes     FanClubPostLike[]

  @@index([fanClubId, createdAt])
  @@index([userId])
  @@map("fan_club_posts")
}

// Like on fan club post
model FanClubPostLike {
  id        String      @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime    @default(now())
  post      FanClubPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@map("fan_club_post_likes")
}

// Trending topics / platform trends
model TrendingTopic {
  id          String    @id @default(cuid())
  title       String // Topic title
  slug        String    @unique
  category    String // burc, fal, unlu, genel, oyun, etkinlik
  description String?   @db.Text
  image       String? // Cover image URL
  icon        String? // Emoji or icon
  trendScore  Int       @default(0) // Calculated popularity score
  viewCount   Int       @default(0)
  likeCount   Int       @default(0)
  isActive    Boolean   @default(true)
  isPinned    Boolean   @default(false) // Admin pinned
  relatedUrl  String? // Link to related page
  tags        String?   @db.Text // JSON array of tags
  startDate   DateTime  @default(now())
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([category])
  @@index([isActive, trendScore])
  @@index([isPinned])
  @@map("trending_topics")
}

// Celebrity social media posts (admin-managed)
model CelebrityPost {
  id           String                 @id @default(cuid())
  celebrityId  String
  celebrity    Celebrity              @relation(fields: [celebrityId], references: [id], onDelete: Cascade)
  platform     String // instagram, x, youtube, tiktok
  postType     String                 @default("photo") // photo, video, reel, story, tweet, short
  content      String?                @db.Text
  mediaUrl     String? // Image or video thumbnail URL
  externalUrl  String? // Link to original post
  likeCount    Int                    @default(0)
  commentCount Int                    @default(0)
  isActive     Boolean                @default(true)
  isPinned     Boolean                @default(false)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  likes        CelebrityPostLike[]
  comments     CelebrityPostComment[]

  @@index([celebrityId, createdAt])
  @@index([platform])
  @@index([isActive])
  @@index([isPinned])
  @@map("celebrity_posts")
}

// Like on celebrity post
model CelebrityPostLike {
  id        String        @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime      @default(now())
  post      CelebrityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@map("celebrity_post_likes")
}

// Comment on celebrity post
model CelebrityPostComment {
  id        String        @id @default(cuid())
  postId    String
  userId    String
  content   String        @db.Text
  createdAt DateTime      @default(now())
  post      CelebrityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([userId])
  @@map("celebrity_post_comments")
}

model UserStory {
  id        String   @id @default(cuid())
  userId    String
  mediaUrl  String
  mediaType String   @default("image") // image or video
  caption   String?  @db.Text
  viewCount Int      @default(0)
  isActive  Boolean  @default(true)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive, expiresAt])
  @@index([expiresAt])
  @@map("user_stories")
}

// Video categories for trend videos
model TrendVideoCategory {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  description String?      @db.Text
  sortOrder   Int          @default(0)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  videos      TrendVideo[]

  @@index([isActive, sortOrder])
  @@map("trend_video_categories")
}

// Individual trend videos (YouTube)
model TrendVideo {
  id           String             @id @default(cuid())
  categoryId   String
  category     TrendVideoCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title        String
  youtubeId    String // YouTube video ID
  thumbnailUrl String? // YouTube thumbnail
  channelName  String?
  duration     String? // e.g. "12:34"
  viewCount    Int                @default(0)
  sortOrder    Int                @default(0)
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([categoryId, sortOrder])
  @@index([isActive, createdAt])
  @@map("trend_videos")
}

// TikTok embedded videos
model TikTokCategory {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String?       @db.Text
  sortOrder   Int           @default(0)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  videos      TikTokVideo[]

  @@index([isActive, sortOrder])
  @@map("tiktok_categories")
}

model TikTokVideo {
  id           String          @id @default(cuid())
  tiktokUrl    String // Full TikTok video URL
  tiktokId     String? // Extracted video ID
  title        String?
  authorName   String?
  authorAvatar String?
  thumbnailUrl String?
  embedHtml    String?         @db.Text
  categoryId   String?
  category     TikTokCategory? @relation(fields: [categoryId], references: [id])
  sortOrder    Int             @default(0)
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([isActive, sortOrder])
  @@index([categoryId])
  @@map("tiktok_videos")
}

// CFC (CanlıFal Coin) Payment Requests
model CfcPaymentRequest {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount     Int // CFC amount requested
  method     String // whatsapp, papara, bank_transfer
  senderInfo String? // Sender name or phone for verification
  notes      String?  @db.Text
  status     String   @default("pending") // pending, approved, rejected
  reviewedBy String? // Admin user id who reviewed
  reviewNote String? // Admin note on approval/rejection
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("cfc_payment_requests")
}

// ═══════════════════════════════════════════════════════════
// Short Videos (TikTok-style)
// ═══════════════════════════════════════════════════════════

model ShortVideo {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoUrl       String // R2/CDN full URL
  thumbnailUrl   String? // R2/CDN thumbnail URL
  description    String?          @db.VarChar(500)
  durationSec    Float?
  viewsCount     Int              @default(0)
  likesCount     Int              @default(0)
  commentsCount  Int              @default(0)
  sharesCount    Int              @default(0)
  savesCount     Int              @default(0)
  // Görünürlük: everyone | followers | close_friends | private
  visibility     String           @default("everyone")
  // Yorum ayarı: everyone | followers | off
  commentSetting String           @default("everyone")
  allowDuet      Boolean          @default(true)
  // Konum
  locationName   String?
  locationLat    Float?
  locationLng    Float?
  // Müzik
  musicId        String?
  music          ShortVideoMusic? @relation(fields: [musicId], references: [id], onDelete: SetNull)
  // Duet / Remix kaynağı
  duetOfId       String?
  duetOf         ShortVideo?      @relation("Duet", fields: [duetOfId], references: [id], onDelete: SetNull)
  duets          ShortVideo[]     @relation("Duet")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  likes    ShortVideoLike[]
  comments ShortVideoComment[]
  views    ShortVideoView[]
  saves    ShortVideoSave[]
  mentions ShortVideoMention[]
  hashtags ShortVideoHashtag[]

  @@index([createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([visibility, createdAt(sort: Desc)])
  @@index([musicId])
  @@index([duetOfId])
  @@map("short_videos")
}

model ShortVideoLike {
  id        String     @id @default(cuid())
  videoId   String
  video     ShortVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
