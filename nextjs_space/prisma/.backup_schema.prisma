  type      String   // login, custom
  message   String
  color     String   @default("red") // red, gold, etc.
  userId    String?
  userName  String?
  maxPasses Int      @default(1) // how many times banner scrolls across screen
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([createdAt])
  @@index([expiresAt])
  @@map("site_announcements")
