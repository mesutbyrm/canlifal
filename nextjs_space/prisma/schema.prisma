generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "/home/ubuntu/fortune_telling_platform/nextjs_space/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String               @id @default(cuid())
  email                 String               @unique
  emailVerified         DateTime?
  password              String?
  name                  String
  image                 String?
  preferredLanguage     String               @default("tr")
  credits               Int                  @default(10)
  role                  String               @default("user")
  createdAt             DateTime             @default(now())
  referralCode          String?              @unique
  referralCreditsEarned Int                  @default(0)
  referredById          String?
  accounts              Account[]
  bannedOthers          ChatBan[]            @relation("Banner")
  bannedIn              ChatBan[]            @relation("BannedUser")
  chatMessages          ChatMessage[]
  mutedOthers           ChatMute[]           @relation("Muter")
  mutedIn               ChatMute[]           @relation("MutedUser")
  chatPresences         ChatPresence[]
  chatRoles             ChatUserRole[]
  fortunes              Fortune[]
  fortuneTellerProfile  LiveFortuneTeller?
  liveSessions          LiveSession[]        @relation("SessionUser")
  notifications         Notification[]
  passwordResets        PasswordResetToken[]
  referredHistory       Referral[]           @relation("Referred")
  referralHistory       Referral[]           @relation("Referrer")
  sessions              Session[]
  socialComments        SocialComment[]
  socialLikes           SocialLike[]
  socialPosts           SocialPost[]
  referredBy            User?                @relation("UserReferrals", fields: [referredById], references: [id])
  referrals             User[]               @relation("UserReferrals")

  @@index([referralCode])
  @@index([referredById])
  @@map("users")
}

model Referral {
  id             String   @id @default(cuid())
  referrerId     String
  referredId     String
  creditsAwarded Int      @default(50)
  createdAt      DateTime @default(now())
  referred       User     @relation("Referred", fields: [referredId], references: [id], onDelete: Cascade)
  referrer       User     @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)

  @@unique([referrerId, referredId])
  @@index([referrerId])
  @@index([createdAt])
  @@map("referrals")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("password_reset_tokens")
}

model LiveFortuneTeller {
  id                String             @id @default(cuid())
  userId            String             @unique
  displayName       String
  bio               String?
  specialties       String[]
  pricePerSession   Int                @default(100)
  rating            Float              @default(5.0)
  totalSessions     Int                @default(0)
  totalReviews      Int                @default(0)
  isOnline          Boolean            @default(false)
  isVerified        Boolean            @default(false)
  isActive          Boolean            @default(true)
  avatar            String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  applicationNote   String?
  applicationStatus String             @default("pending")
  approvedAt        DateTime?
  banReason         String?
  bannedAt          DateTime?
  bonusCredits      Int                @default(0)
  freezeReason      String?
  frozenAt          DateTime?
  isBanned          Boolean            @default(false)
  isFrozen          Boolean            @default(false)
  rejectedAt        DateTime?
  totalEarnings     Int                @default(0)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions          LiveSession[]
  reviews           LiveTellerReview[]
  warnings          TellerWarning[]

  @@index([isOnline])
  @@index([isVerified])
  @@index([rating])
  @@index([applicationStatus])
  @@index([isBanned])
  @@map("live_fortune_tellers")
}

model TellerWarning {
  id        String            @id @default(cuid())
  tellerId  String
  reason    String
  issuedBy  String
  createdAt DateTime          @default(now())
  teller    LiveFortuneTeller @relation(fields: [tellerId], references: [id], onDelete: Cascade)

  @@index([tellerId])
  @@map("teller_warnings")
}

model LiveSession {
  id             String               @id @default(cuid())
  tellerId       String
  userId         String
  fortuneType    String
  status         String               @default("pending")
  creditsCharged Int
  startedAt      DateTime?
  endedAt        DateTime?
  notes          String?
  createdAt      DateTime             @default(now())
  messages       LiveSessionMessage[]
  teller         LiveFortuneTeller    @relation(fields: [tellerId], references: [id], onDelete: Cascade)
  user           User                 @relation("SessionUser", fields: [userId], references: [id], onDelete: Cascade)
  review         LiveTellerReview?

  @@index([tellerId])
  @@index([userId])
  @@index([status])
  @@map("live_sessions")
}

model LiveSessionMessage {
  id        String      @id @default(cuid())
  sessionId String
  senderId  String
  message   String
  createdAt DateTime    @default(now())
  session   LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("live_session_messages")
}

model LiveTellerReview {
  id        String            @id @default(cuid())
  tellerId  String
  sessionId String            @unique
  rating    Int
  comment   String?
  createdAt DateTime          @default(now())
  session   LiveSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  teller    LiveFortuneTeller @relation(fields: [tellerId], references: [id], onDelete: Cascade)

  @@index([tellerId])
  @@map("live_teller_reviews")
}

model Fortune {
  id          String       @id @default(cuid())
  userId      String
  fortuneType String
  inputData   String
  aiResponse  String
  language    String
  createdAt   DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  socialPosts SocialPost[]

  @@index([userId])
  @@index([fortuneType])
  @@index([createdAt])
  @@map("fortunes")
}

model Translation {
  id               String @id @default(cuid())
  languageCode     String
  translationKey   String
  translationValue String

  @@unique([languageCode, translationKey])
  @@index([languageCode])
  @@map("translations")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model ChatRoom {
  id        String         @id @default(cuid())
  slug      String         @unique
  nameEn    String
  nameTr    String
  descEn    String
  descTr    String
  icon      String
  isActive  Boolean        @default(true)
  isMuted   Boolean        @default(false)
  createdAt DateTime       @default(now())
  bans      ChatBan[]
  messages  ChatMessage[]
  mutes     ChatMute[]
  presences ChatPresence[]
  userRoles ChatUserRole[]

  @@map("chat_rooms")
}

model ChatMessage {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  room      ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@index([userId])
  @@map("chat_messages")
}

model ChatPresence {
  id         String    @id @default(cuid())
  roomId     String
  userId     String
  nickname   String?
  isTyping   Boolean   @default(false)
  lastTyping DateTime?
  lastSeen   DateTime  @default(now())
  room       ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId])
  @@map("chat_presences")
}

model ChatUserRole {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  role      String
  grantedBy String?
  createdAt DateTime @default(now())
  room      ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId])
  @@map("chat_user_roles")
}

model ChatMute {
  id        String    @id @default(cuid())
  roomId    String
  userId    String
  mutedBy   String
  reason    String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  muter     User      @relation("Muter", fields: [mutedBy], references: [id], onDelete: Cascade)
  room      ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User      @relation("MutedUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId])
  @@map("chat_mutes")
}

model ChatBan {
  id        String    @id @default(cuid())
  roomId    String
  userId    String
  bannedBy  String
  reason    String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  banner    User      @relation("Banner", fields: [bannedBy], references: [id], onDelete: Cascade)
  room      ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User      @relation("BannedUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId])
  @@map("chat_bans")
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

model SocialPost {
  id          String          @id @default(cuid())
  userId      String
  fortuneId   String?
  content     String
  postType    String
  fortuneType String?
  isPublic    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  imageUrl    String?
  isAuto      Boolean         @default(false)
  audioUrl    String?
  youtubeUrl  String?
  comments    SocialComment[]
  likes       SocialLike[]
  fortune     Fortune?        @relation(fields: [fortuneId], references: [id])
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([postType])
  @@map("social_posts")
}

model SocialComment {
  id        String     @id @default(cuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime   @default(now())
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
  @@map("social_comments")
}

model SocialLike {
  id        String     @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime   @default(now())
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@map("social_likes")
}

model AnonymousUser {
  id                String             @id @default(cuid())
  username          String             @unique
  deviceId          String             @unique
  credits           Int                @default(0)
  adsWatched        Int                @default(0)
  adsWatchedToday   Int                @default(0)
  lastAdDate        DateTime?
  fortunesUsed      Int                @default(0)
  createdAt         DateTime           @default(now())
  anonymousFortunes AnonymousFortune[]

  @@map("anonymous_users")
}

model AnonymousFortune {
  id              String        @id @default(cuid())
  anonymousUserId String
  fortuneType     String
  inputData       String
  aiResponse      String
  language        String
  createdAt       DateTime      @default(now())
  anonymousUser   AnonymousUser @relation(fields: [anonymousUserId], references: [id], onDelete: Cascade)

  @@index([anonymousUserId])
  @@map("anonymous_fortunes")
}

model SitePresence {
  id        String   @id @default(cuid())
  visitorId String   @unique
  userId    String?
  lastSeen  DateTime @default(now())
  userAgent String?
  path      String?

  @@index([lastSeen])
  @@map("site_presences")
}

model SiteVisit {
  id        String   @id @default(cuid())
  visitorId String
  userId    String?
  visitedAt DateTime @default(now())
  path      String?
  userAgent String?
  country   String?
  city      String?
  ipHash    String?

  @@index([visitedAt])
  @@index([visitorId])
  @@index([country])
  @@map("site_visits")
}

model Notification {
  id           String   @id @default(cuid())
  userId       String
  type         String
  message      String
  postId       String?
  fromUserId   String?
  fromUserName String?
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}
