  totalJetons    Int      @default(0) // lifetime jetons earned from games
  totalGames     Int      @default(0)
  level          Int      @default(1)
  levelTitle     String   @default("Yeni Üye")
  dailySpinsUsed Int      @default(0) // daily free spin count
  lastSpinDate   DateTime? @db.Date
  referralCode   String?  @unique
  referralCount  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([totalJetons])
  @@map("user_game_profiles")
}

// Admin-uploaded images for broadcasters to use as screen capture
model BroadcastImage {
  id          String   @id @default(cuid())
  name        String   // Display name for the image
  imageUrl    String   // URL to the image
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("broadcast_images")
}

// Custom Badges - admin can create badges and assign to tiers or users
model CustomBadge {
  id          String   @id @default(cuid())
  name        String   // Badge display name
  icon        String   // Emoji or icon identifier
  color       String   @default("#fbbf24") // Badge color (hex)
  bgColor     String   @default("#78350f") // Background color (hex)
  description String?  // Description of badge
  tier        String?  // If set, auto-assigned to this membership tier (basic, premium, gold, diamond)
  userId      String?  // If set, assigned to specific user
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tier])
  @@index([userId])
  @@index([isActive])
  @@map("custom_badges")
}

// Site Pages - admin managed pages (About, Privacy, etc.)
model SitePage {
  id          String   @id @default(cuid())
  title       String   // Page title
  titleEn     String?  // English title
  slug        String   @unique // URL slug
  content     String   @db.Text // HTML content
  contentEn   String?  @db.Text // English content
  isPublished Boolean  @default(true)
  showInFooter Boolean @default(true)
  showInHeader Boolean @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([isPublished])
  @@index([sortOrder])
  @@map("site_pages")
}

// Push Notification Log - tracks all notifications sent via admin panel
model PushNotificationLog {
  id              String   @id @default(cuid())
  onesignalId     String?  // OneSignal notification ID for tracking
  title           String
  message         String   @db.Text
  url             String?
  imageUrl        String?
  targetType      String   // all, segment, tag, player_id, quick_action
  targetValue     String?  // segment name, tag filter, player_id, etc.
  scheduledAt     DateTime? // null = sent immediately
  status          String   @default("sent") // sent, scheduled, failed, cancelled
  recipientCount  Int      @default(0)
  deliveredCount  Int      @default(0)
  clickedCount    Int      @default(0)
  errorMessage    String?
  createdBy       String   // admin user id
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([targetType])
  @@map("push_notification_logs")
}

model DreamInterpretation {
  id              String           @id @default(cuid())
  title           String
  slug            String           @unique
  content         String           @db.Text
  summary         String?          @db.Text
  keywords        String[]         @default([])
  metaDescription String?
  views           Int              @default(0)
  isPublished     Boolean          @default(true)
  isAiGenerated   Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  comments        DreamComment[]
  favorites       DreamFavorite[]
  dreamViews      DreamView[]

  @@index([slug])
  @@index([views])
  @@index([createdAt])
  @@index([isPublished])
  @@map("dream_interpretations")
}

model DreamComment {
  id        String              @id @default(cuid())
  content   String              @db.Text
  userId    String
  dreamId   String
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  dream     DreamInterpretation @relation(fields: [dreamId], references: [id], onDelete: Cascade)

  @@index([dreamId, createdAt])
  @@index([userId])
  @@map("dream_comments")
}

model DreamFavorite {
  id        String              @id @default(cuid())
  userId    String
  dreamId   String
  createdAt DateTime            @default(now())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  dream     DreamInterpretation @relation(fields: [dreamId], references: [id], onDelete: Cascade)

  @@unique([userId, dreamId])
  @@index([userId])
  @@index([dreamId])
  @@map("dream_favorites")
}

model DreamView {
  id        String              @id @default(cuid())
  userId    String
  dreamId   String
  createdAt DateTime            @default(now())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  dream     DreamInterpretation @relation(fields: [dreamId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([dreamId])
  @@map("dream_views")
}

// Dream Symbol Dictionary (A-Z)
model DreamSymbol {
  id              String   @id @default(cuid())
  name            String   @unique
  slug            String   @unique
  letter          String   // First letter for A-Z grouping
  meaning         String   @db.Text
  detailedMeaning String?  @db.Text
  relatedSymbols  String[] @default([])
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([letter])
  @@index([slug])
  @@index([isPublished])
  @@map("dream_symbols")
}

// Dream Diary - Personal Dream Journal
model DreamDiaryEntry {
  id          String   @id @default(cuid())
  userId      String
  dreamDate   DateTime @db.Date
  title       String
  content     String   @db.Text
  symbols     String[] @default([])
  mood        String?  // happy, sad, scared, confused, neutral
  lucidity    Int?     // 1-5 lucidity scale
  aiAnalysis  String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dreamDate])
  @@index([userId, dreamDate])
  @@index([createdAt])
  @@map("dream_diary_entries")
}

// Daily Login Reward
model DailyLoginReward {
  id          String   @id @default(cuid())
  userId      String
  rewardDate  DateTime @db.Date
  streak      Int      @default(1)
  xpEarned    Int      @default(10)
  jetonEarned Int      @default(0)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, rewardDate])
  @@index([userId])
  @@map("daily_login_rewards")
}

// Dream Interpretation Contest
model DreamContest {
  id          String              @id @default(cuid())
  title       String
  description String              @db.Text
  dreamPrompt String              @db.Text
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  entries     DreamContestEntry[]

  @@index([isActive])
  @@index([endDate])
  @@map("dream_contests")
}

model DreamContestEntry {
  id            String            @id @default(cuid())
  contestId     String
  userId        String
  interpretation String           @db.Text
  voteCount     Int               @default(0)
  createdAt     DateTime          @default(now())
  contest       DreamContest      @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes         DreamContestVote[]

  @@unique([contestId, userId])
  @@index([contestId, voteCount])
  @@index([userId])
  @@map("dream_contest_entries")
}

model DreamContestVote {
  id        String            @id @default(cuid())
  entryId   String
  userId    String
  createdAt DateTime          @default(now())
  entry     DreamContestEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([entryId, userId])
  @@index([entryId])
  @@index([userId])
  @@map("dream_contest_votes")
}

// Weekly Dream Report (AI-generated)
model WeeklyDreamReport {
  id          String   @id @default(cuid())
  userId      String
  weekStart   DateTime @db.Date
  weekEnd     DateTime @db.Date
  reportContent String @db.Text
  dreamCount  Int      @default(0)
  topSymbols  String[] @default([])
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@index([userId])
  @@map("weekly_dream_reports")
}