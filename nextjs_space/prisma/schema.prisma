generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "/home/ubuntu/fortune_telling_platform/nextjs_space/node_modules/.prisma/client"
}

datasource db {
    provider = "mysql"
    url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  password          String
  name              String
  preferredLanguage String    @default("en")
  credits           Int       @default(10)
  role              String    @default("user")
  createdAt         DateTime  @default(now())
  fortunes          Fortune[]
  accounts          Account[]
  sessions          Session[]
  chatMessages      ChatMessage[]
  chatPresences     ChatPresence[]
  chatRoles         ChatUserRole[]
  mutedIn           ChatMute[]  @relation("MutedUser")
  mutedOthers       ChatMute[]  @relation("Muter")
  bannedIn          ChatBan[]   @relation("BannedUser")
  bannedOthers      ChatBan[]   @relation("Banner")

  @@map("users")
}

model Fortune {
  id           String   @id @default(cuid())
  userId       String
  fortuneType  String
  inputData    String   @db.Text
  aiResponse   String   @db.LongText
  language     String
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([fortuneType])
  @@index([createdAt])
  @@map("fortunes")
}

model Translation {
  id               String @id @default(cuid())
  languageCode     String
  translationKey   String
  translationValue String

  @@unique([languageCode, translationKey])
  @@index([languageCode])
  @@map("translations")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model ChatRoom {
  id          String        @id @default(cuid())
  slug        String        @unique
  nameEn      String
  nameTr      String
  descEn      String
  descTr      String
  icon        String
  isActive    Boolean       @default(true)
  isMuted     Boolean       @default(false)
  createdAt   DateTime      @default(now())
  messages    ChatMessage[]
  presences   ChatPresence[]
  userRoles   ChatUserRole[]
  mutes       ChatMute[]
  bans        ChatBan[]

  @@map("chat_rooms")
}

model ChatMessage {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())
  room      ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@index([userId])
  @@map("chat_messages")
}

model ChatPresence {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  nickname  String?
  lastSeen  DateTime @default(now())
  room      ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId])
  @@map("chat_presences")
}

// Chat user roles: founder (~), admin (&), op (@), voice (+)
model ChatUserRole {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  role      String   // founder, admin, op, voice
  grantedBy String?
  createdAt DateTime @default(now())
  room      ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId])
  @@map("chat_user_roles")
}

// Muted users in a room
model ChatMute {
  id        String    @id @default(cuid())
  roomId    String
  userId    String
  mutedBy   String
  reason    String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  room      ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, name: "MutedUser")
  muter     User      @relation(fields: [mutedBy], references: [id], onDelete: Cascade, name: "Muter")

  @@unique([roomId, userId])
  @@index([roomId])
  @@map("chat_mutes")
}

// Banned users from a room
model ChatBan {
  id        String    @id @default(cuid())
  roomId    String
  userId    String
  bannedBy  String
  reason    String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  room      ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, name: "BannedUser")
  banner    User      @relation(fields: [bannedBy], references: [id], onDelete: Cascade, name: "Banner")

  @@unique([roomId, userId])
  @@index([roomId])
  @@map("chat_bans")
}

// Site settings for ads and other configurations
model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}
