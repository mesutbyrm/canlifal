// PostgreSQL database configuration
generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "/home/ubuntu/fortune_telling_platform/nextjs_space/node_modules/.prisma/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  emailVerified     DateTime?
  password          String?
  name              String
  image             String?
  preferredLanguage String    @default("tr")
  credits           Int       @default(10)
  role              String    @default("user")
  createdAt         DateTime  @default(now())
  fortunes          Fortune[]
  accounts          Account[]
  sessions          Session[]
  chatMessages      ChatMessage[]
  chatPresences     ChatPresence[]
  chatRoles         ChatUserRole[]
  mutedIn           ChatMute[]  @relation("MutedUser")
  mutedOthers       ChatMute[]  @relation("Muter")
  bannedIn          ChatBan[]   @relation("BannedUser")
  bannedOthers      ChatBan[]   @relation("Banner")
  socialPosts       SocialPost[]
  socialComments    SocialComment[]
  socialLikes       SocialLike[]
  notifications     Notification[]

  @@map("users")
}

model Fortune {
  id           String   @id @default(cuid())
  userId       String
  fortuneType  String
  inputData    String   @db.Text
  aiResponse   String
  language     String
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  socialPosts  SocialPost[]

  @@index([userId])
  @@index([fortuneType])
  @@index([createdAt])
  @@map("fortunes")
}

model Translation {
  id               String @id @default(cuid())
  languageCode     String
  translationKey   String
  translationValue String

  @@unique([languageCode, translationKey])
  @@index([languageCode])
  @@map("translations")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model ChatRoom {
  id          String        @id @default(cuid())
  slug        String        @unique
  nameEn      String
  nameTr      String
  descEn      String
  descTr      String
  icon        String
  isActive    Boolean       @default(true)
  isMuted     Boolean       @default(false)
  createdAt   DateTime      @default(now())
  messages    ChatMessage[]
  presences   ChatPresence[]
  userRoles   ChatUserRole[]
  mutes       ChatMute[]
  bans        ChatBan[]

  @@map("chat_rooms")
}

model ChatMessage {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())
  room      ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@index([userId])
  @@map("chat_messages")
}

model ChatPresence {
  id         String    @id @default(cuid())
  roomId     String
  userId     String
  nickname   String?
  isTyping   Boolean   @default(false)
  lastTyping DateTime?
  lastSeen   DateTime  @default(now())
  room       ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId])
  @@map("chat_presences")
}

// Chat user roles: founder (~), admin (&), op (@), voice (+)
model ChatUserRole {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  role      String   // founder, admin, op, voice
  grantedBy String?
  createdAt DateTime @default(now())
  room      ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId])
  @@map("chat_user_roles")
}

// Muted users in a room
model ChatMute {
  id        String    @id @default(cuid())
  roomId    String
  userId    String
  mutedBy   String
  reason    String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  room      ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, name: "MutedUser")
  muter     User      @relation(fields: [mutedBy], references: [id], onDelete: Cascade, name: "Muter")

  @@unique([roomId, userId])
  @@index([roomId])
  @@map("chat_mutes")
}

// Banned users from a room
model ChatBan {
  id        String    @id @default(cuid())
  roomId    String
  userId    String
  bannedBy  String
  reason    String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  room      ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, name: "BannedUser")
  banner    User      @relation(fields: [bannedBy], references: [id], onDelete: Cascade, name: "Banner")

  @@unique([roomId, userId])
  @@index([roomId])
  @@map("chat_bans")
}

// Site settings for ads and other configurations
model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// Social Posts - Users can share fortunes or custom text
model SocialPost {
  id          String    @id @default(cuid())
  userId      String
  fortuneId   String?   // Optional: linked fortune
  content     String    @db.Text
  imageUrl    String?   // Optional: image URL for the post
  audioUrl    String?   // Optional: audio URL for voice posts
  youtubeUrl  String?   // Optional: YouTube video URL
  postType    String    // "fortune", "text", "horoscope"
  fortuneType String?   // coffee, tarot, etc. if fortune post
  isAuto      Boolean   @default(false) // True if auto-shared from fortune
  isPublic    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fortune     Fortune?  @relation(fields: [fortuneId], references: [id], onDelete: SetNull)
  comments    SocialComment[]
  likes       SocialLike[]

  @@index([userId])
  @@index([createdAt])
  @@index([postType])
  @@map("social_posts")
}

// Comments on social posts
model SocialComment {
  id        String     @id @default(cuid())
  postId    String
  userId    String
  content   String     @db.Text
  createdAt DateTime   @default(now())
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
  @@map("social_comments")
}

// Likes on social posts
model SocialLike {
  id        String     @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime   @default(now())
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@map("social_likes")
}

// Anonymous users who use the platform without registration
model AnonymousUser {
  id              String   @id @default(cuid())
  username        String   @unique
  deviceId        String   @unique
  credits         Int      @default(0)
  adsWatched      Int      @default(0)
  adsWatchedToday Int      @default(0)
  lastAdDate      DateTime?
  fortunesUsed    Int      @default(0)
  createdAt       DateTime @default(now())
  anonymousFortunes AnonymousFortune[]

  @@map("anonymous_users")
}

// Fortune readings for anonymous users
model AnonymousFortune {
  id              String        @id @default(cuid())
  anonymousUserId String
  fortuneType     String
  inputData       String        @db.Text
  aiResponse      String        @db.Text
  language        String
  createdAt       DateTime      @default(now())
  anonymousUser   AnonymousUser @relation(fields: [anonymousUserId], references: [id], onDelete: Cascade)

  @@index([anonymousUserId])
  @@map("anonymous_fortunes")
}

// Notifications for users (likes, comments, etc.)
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // "like", "comment", "share"
  message   String
  postId    String?
  fromUserId String?
  fromUserName String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}
