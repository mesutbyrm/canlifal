generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "/home/ubuntu/fortune_telling_platform/nextjs_space/node_modules/.prisma/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
  id                    String               @id @default(cuid())
  email                 String               @unique
  emailVerified         DateTime?
  password              String?
  name                  String
  username              String?              @unique
  phone                 String?
  image                 String?
  preferredLanguage     String               @default("tr")
  credits               Int                  @default(10)
  role                  String               @default("user")
  membership            String               @default("basic") // basic, premium, gold
  membershipExpiresAt   DateTime?
  createdAt             DateTime             @default(now())
  referralCode          String?              @unique
  referralCreditsEarned Int                  @default(0)
  referredById          String?
  // Profile fields
  bio                   String?              // User bio/about text
  birthDate             DateTime?
  birthTime             String?              // HH:mm format for rising sign calculation
  zodiacSign            String?
  risingSign            String?
  favoriteTeam          String?
  lastHoroscopeDate     DateTime?            // Track when daily horoscope was last generated
  // Privacy settings
  messagePrivacy        String               @default("everyone") // everyone, followers, nobody
  // Theme preference
  theme                 String               @default("mystical") // mystical, facebook
  // Jeton (token) balance for Bana Özel
  jetonBalance          Int                  @default(50)
  // Profile customization
  specialBadges         String?              // JSON array of special badge types (vip, beta_tester, verified, etc.)
  profileEffect         String?              // Profile background effect (sparkles, fire, rainbow, etc.)
  // Statistics
  totalTimeSpentMinutes Int                  @default(0)
  lastActiveAt          DateTime?
  accounts              Account[]
  bannedOthers          ChatBan[]            @relation("Banner")
  bannedIn              ChatBan[]            @relation("BannedUser")
  chatMessages          ChatMessage[]
  mutedOthers           ChatMute[]           @relation("Muter")
  mutedIn               ChatMute[]           @relation("MutedUser")
  chatPresences         ChatPresence[]
  chatRoles             ChatUserRole[]
  ownedChatRooms        ChatRoom[]           @relation("RoomOwner")
  fortunes              Fortune[]
  fortuneTellerProfile  LiveFortuneTeller?
  liveSessions          LiveSession[]        @relation("SessionUser")
  notifications         Notification[]
  passwordResets        PasswordResetToken[]
  referredHistory       Referral[]           @relation("Referred")
  referralHistory       Referral[]           @relation("Referrer")
  sessions              Session[]
  socialComments        SocialComment[]
  socialLikes           SocialLike[]
  socialPosts           SocialPost[]
  payments              Payment[]
  referredBy            User?                @relation("UserReferrals", fields: [referredById], references: [id])
  referrals             User[]               @relation("UserReferrals")
  videoStreams          VideoStream[]
  videoStreamComments   VideoStreamComment[]
  videoStreamLikes      VideoStreamLike[]
  streamGifts           StreamGift[]
  followers             Follow[]             @relation("Following")
  following             Follow[]             @relation("Follower")
  sentMessages          DirectMessage[]      @relation("SentMessages")
  receivedMessages      DirectMessage[]      @relation("ReceivedMessages")
  conversationsAsUser1  Conversation[]       @relation("ConversationUser1")
  conversationsAsUser2  Conversation[]       @relation("ConversationUser2")
  sentRequests          MessageRequest[]     @relation("SentRequests")
  receivedRequests      MessageRequest[]     @relation("ReceivedRequests")

  @@index([referralCode])
  @@index([referredById])
  @@index([username])
  @@map("users")
}

// Follow relationship between users
model Follow {
  id          String   @id @default(cuid())
  followerId  String   // The user who is following
  followingId String   // The user being followed
  createdAt   DateTime @default(now())
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

model Referral {
  id             String   @id @default(cuid())
  referrerId     String
  referredId     String
  creditsAwarded Int      @default(50)
  createdAt      DateTime @default(now())
  referred       User     @relation("Referred", fields: [referredId], references: [id], onDelete: Cascade)
  referrer       User     @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)

  @@unique([referrerId, referredId])
  @@index([referrerId])
  @@index([createdAt])
  @@map("referrals")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("password_reset_tokens")
}

model LiveFortuneTeller {
  id                String             @id @default(cuid())
  userId            String             @unique
  displayName       String
  bio               String?
  specialties       String[]
  pricePerSession   Int                @default(100)
  rating            Float              @default(5.0)
  totalSessions     Int                @default(0)
  totalReviews      Int                @default(0)
  isOnline          Boolean            @default(false)
  isVerified        Boolean            @default(false)
  isActive          Boolean            @default(true)
  avatar            String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  applicationNote   String?
  applicationStatus String             @default("pending")
  approvedAt        DateTime?
  banReason         String?
  bannedAt          DateTime?
  bonusCredits      Int                @default(0)
  freezeReason      String?
  frozenAt          DateTime?
  isBanned          Boolean            @default(false)
  isFrozen          Boolean            @default(false)
  rejectedAt        DateTime?
  totalEarnings     Int                @default(0)
  // Teller permissions (admin controlled)
  canGoOnline       Boolean            @default(true)
  canChat           Boolean            @default(true)
  canStartSession   Boolean            @default(true)
  canSetPrice       Boolean            @default(false)
  canEditProfile    Boolean            @default(true)
  canViewEarnings   Boolean            @default(true)
  canWithdraw       Boolean            @default(false)
  maxSessionsPerDay Int                @default(10)
  commissionRate    Int                @default(20)
  adminNotes        String?
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions          LiveSession[]
  reviews           LiveTellerReview[]
  warnings          TellerWarning[]

  @@index([isOnline])
  @@index([isVerified])
  @@index([rating])
  @@index([applicationStatus])
  @@index([isBanned])
  @@map("live_fortune_tellers")
}

model TellerWarning {
  id        String            @id @default(cuid())
  tellerId  String
  reason    String
  issuedBy  String
  createdAt DateTime          @default(now())
  teller    LiveFortuneTeller @relation(fields: [tellerId], references: [id], onDelete: Cascade)

  @@index([tellerId])
  @@map("teller_warnings")
}

model LiveSession {
  id               String               @id @default(cuid())
  tellerId         String
  userId           String
  fortuneType      String
  status           String               @default("pending")
  creditsCharged   Int
  startedAt        DateTime?
  endedAt          DateTime?
  notes            String?
  createdAt        DateTime             @default(now())
  // Room and duration tracking
  roomId           String?              @unique
  maxMinutes       Int                  @default(5)
  minutesUsed      Int                  @default(0)
  creditsPerMinute Int                  @default(0)
  lastPingAt       DateTime?
  timerStarted     Boolean              @default(false)
  timerStartedAt   DateTime?
  messages         LiveSessionMessage[]
  teller           LiveFortuneTeller    @relation(fields: [tellerId], references: [id], onDelete: Cascade)
  user             User                 @relation("SessionUser", fields: [userId], references: [id], onDelete: Cascade)
  review           LiveTellerReview?
  chatSession      TellerChatSession?
  roomSignals      RoomSignal[]

  @@index([tellerId])
  @@index([userId])
  @@index([status])
  @@index([roomId])
  @@map("live_sessions")
}

// WebRTC Signaling for real-time communication
model RoomSignal {
  id          String      @id @default(cuid())
  sessionId   String
  senderId    String
  receiverId  String
  signalType  String      // offer, answer, ice-candidate
  signalData  String      // JSON string of WebRTC signal data
  processed   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  session     LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([receiverId, processed])
  @@map("room_signals")
}

model LiveSessionMessage {
  id        String      @id @default(cuid())
  sessionId String
  senderId  String
  message   String
  createdAt DateTime    @default(now())
  session   LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("live_session_messages")
}

model LiveTellerReview {
  id        String            @id @default(cuid())
  tellerId  String
  sessionId String            @unique
  rating    Int
  comment   String?
  createdAt DateTime          @default(now())
  session   LiveSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  teller    LiveFortuneTeller @relation(fields: [tellerId], references: [id], onDelete: Cascade)

  @@index([tellerId])
  @@map("live_teller_reviews")
}

model Fortune {
  id          String       @id @default(cuid())
  userId      String
  fortuneType String
  inputData   String
  aiResponse  String
  language    String
  viewCount   Int          @default(0)
  isSaved     Boolean      @default(false)
  isPinned    Boolean      @default(false)
  pinnedAt    DateTime?
  createdAt   DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  socialPosts SocialPost[]

  @@index([userId])
  @@index([fortuneType])
  @@index([createdAt])
  @@index([isPinned])
  @@map("fortunes")
}

model Translation {
  id               String @id @default(cuid())
  languageCode     String
  translationKey   String
  translationValue String

  @@unique([languageCode, translationKey])
  @@index([languageCode])
  @@map("translations")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model ChatRoom {
  id        String         @id @default(cuid())
  slug      String         @unique
  nameEn    String
  nameTr    String
  descEn    String
  descTr    String
  icon      String
  isActive  Boolean        @default(true)
  isMuted   Boolean        @default(false)
  ownerId   String?        // User who purchased/owns this room
  owner     User?          @relation("RoomOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt DateTime       @default(now())
  bans      ChatBan[]
  messages  ChatMessage[]
  mutes     ChatMute[]
  presences ChatPresence[]
  userRoles ChatUserRole[]

  @@map("chat_rooms")
}

model ChatMessage {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  room      ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@index([userId])
  @@map("chat_messages")
}

model ChatPresence {
  id         String    @id @default(cuid())
  roomId     String
  userId     String
  nickname   String?
  isTyping   Boolean   @default(false)
  lastTyping DateTime?
  lastSeen   DateTime  @default(now())
  room       ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId])
  @@map("chat_presences")
}

model ChatUserRole {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  role      String
  grantedBy String?
  createdAt DateTime @default(now())
  room      ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId])
  @@map("chat_user_roles")
}

model ChatMute {
  id        String    @id @default(cuid())
  roomId    String
  userId    String
  mutedBy   String
  reason    String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  muter     User      @relation("Muter", fields: [mutedBy], references: [id], onDelete: Cascade)
  room      ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User      @relation("MutedUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId])
  @@map("chat_mutes")
}

model ChatBan {
  id        String    @id @default(cuid())
  roomId    String
  userId    String
  bannedBy  String
  reason    String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  banner    User      @relation("Banner", fields: [bannedBy], references: [id], onDelete: Cascade)
  room      ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User      @relation("BannedUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId])
  @@map("chat_bans")
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

model SocialPost {
  id          String          @id @default(cuid())
  userId      String
  fortuneId   String?
  content     String
  postType    String
  fortuneType String?
  isPublic    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  imageUrl    String?
  isAuto      Boolean         @default(false)
  audioUrl    String?
  youtubeUrl  String?
  comments    SocialComment[]
  likes       SocialLike[]
  fortune     Fortune?        @relation(fields: [fortuneId], references: [id])
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([postType])
  @@map("social_posts")
}

model SocialComment {
  id        String     @id @default(cuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime   @default(now())
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
  @@map("social_comments")
}

model SocialLike {
  id        String     @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime   @default(now())
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@map("social_likes")
}

model AnonymousUser {
  id                String             @id @default(cuid())
  username          String             @unique
  deviceId          String             @unique
  credits           Int                @default(0)
  adsWatched        Int                @default(0)
  adsWatchedToday   Int                @default(0)
  lastAdDate        DateTime?
  fortunesUsed      Int                @default(0)
  createdAt         DateTime           @default(now())
  anonymousFortunes AnonymousFortune[]

  @@map("anonymous_users")
}

model AnonymousFortune {
  id              String        @id @default(cuid())
  anonymousUserId String
  fortuneType     String
  inputData       String
  aiResponse      String
  language        String
  createdAt       DateTime      @default(now())
  anonymousUser   AnonymousUser @relation(fields: [anonymousUserId], references: [id], onDelete: Cascade)

  @@index([anonymousUserId])
  @@map("anonymous_fortunes")
}

model SitePresence {
  id        String   @id @default(cuid())
  visitorId String   @unique
  userId    String?
  lastSeen  DateTime @default(now())
  userAgent String?
  path      String?

  @@index([lastSeen])
  @@map("site_presences")
}

model SiteVisit {
  id        String   @id @default(cuid())
  visitorId String
  userId    String?
  visitedAt DateTime @default(now())
  path      String?
  userAgent String?
  country   String?
  city      String?
  ipHash    String?

  @@index([visitedAt])
  @@index([visitorId])
  @@index([country])
  @@map("site_visits")
}

model Notification {
  id           String   @id @default(cuid())
  userId       String
  type         String
  title        String?
  message      String
  data         String?
  postId       String?
  fromUserId   String?
  fromUserName String?
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// Credit Package for purchasing credits
model CreditPackage {
  id           String    @id @default(cuid())
  name         String
  nameEn       String?
  credits      Int
  price        Float
  currency     String    @default("TRY")
  stripePriceId String?
  isActive     Boolean   @default(true)
  isFeatured   Boolean   @default(false)
  bonusCredits Int       @default(0)
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  payments     Payment[]

  @@map("credit_packages")
}

// Payment/Purchase tracking
model Payment {
  id                String        @id @default(cuid())
  userId            String
  packageId         String?
  stripeSessionId   String?       @unique
  stripePaymentIntentId String?   @unique
  amount            Float
  currency          String        @default("TRY")
  creditsAwarded    Int
  status            String        @default("pending") // pending, completed, failed, refunded
  paymentMethod     String?
  createdAt         DateTime      @default(now())
  completedAt       DateTime?
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  package           CreditPackage? @relation(fields: [packageId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([stripeSessionId])
  @@map("payments")
}

// Payment Methods Configuration
model PaymentMethod {
  id          String   @id @default(cuid())
  type        String   @unique // credit_card, bitcoin, bank_transfer
  name        String
  nameEn      String?
  description String?
  descriptionEn String?
  isActive    Boolean  @default(true)
  config      String?  // JSON string for configuration (bank details, wallet address, etc.)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("payment_methods")
}

// Platform settings for admin
model PlatformSettings {
  id                    String   @id @default(cuid())
  key                   String   @unique
  value                 String
  description           String?
  updatedAt             DateTime @updatedAt

  @@map("platform_settings")
}

// Live Chat Session between user and fortune teller
model TellerChatSession {
  id              String              @id @default(cuid())
  liveSessionId   String              @unique
  userId          String
  tellerId        String
  status          String              @default("active") // active, closed
  createdAt       DateTime            @default(now())
  closedAt        DateTime?
  liveSession     LiveSession         @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  messages        TellerChatMessage[]

  @@index([userId])
  @@index([tellerId])
  @@index([status])
  @@map("teller_chat_sessions")
}

// Messages in the live chat
model TellerChatMessage {
  id            String            @id @default(cuid())
  chatSessionId String
  senderId      String
  senderType    String            // "user" or "teller"
  content       String
  messageType   String            @default("text") // text, image
  imageUrl      String?
  isRead        Boolean           @default(false)
  createdAt     DateTime          @default(now())
  chatSession   TellerChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)

  @@index([chatSessionId])
  @@index([createdAt])
  @@map("teller_chat_messages")
}

// TikTok-style Video Stream
model VideoStream {
  id            String              @id @default(cuid())
  userId        String
  title         String?
  description   String?
  status        String              @default("live") // live, ended
  viewerCount   Int                 @default(0)
  likeCount     Int                 @default(0)
  roomId        String              @unique @default(cuid())
  category      String?             // fortune, chat, general
  thumbnailUrl  String?
  startedAt     DateTime            @default(now())
  endedAt       DateTime?
  createdAt     DateTime            @default(now())
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments      VideoStreamComment[]
  likes         VideoStreamLike[]
  viewers       VideoStreamViewer[]
  gifts         StreamGift[]

  @@index([userId])
  @@index([status])
  @@index([startedAt])
  @@map("video_streams")
}

// Comments on video streams
model VideoStreamComment {
  id          String      @id @default(cuid())
  streamId    String
  userId      String
  content     String
  createdAt   DateTime    @default(now())
  stream      VideoStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([streamId])
  @@index([createdAt])
  @@map("video_stream_comments")
}

// Likes on video streams
model VideoStreamLike {
  id        String      @id @default(cuid())
  streamId  String
  userId    String
  createdAt DateTime    @default(now())
  stream    VideoStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([streamId, userId])
  @@index([streamId])
  @@map("video_stream_likes")
}

// Track viewers in video streams
model VideoStreamViewer {
  id         String      @id @default(cuid())
  streamId   String
  viewerId   String
  viewerName String?
  joinedAt   DateTime    @default(now())
  leftAt     DateTime?
  stream     VideoStream @relation(fields: [streamId], references: [id], onDelete: Cascade)

  @@index([streamId])
  @@map("video_stream_viewers")
}

// Gift types available for purchase
model GiftType {
  id          String   @id @default(cuid())
  name        String
  nameEn      String
  icon        String   // emoji or icon name
  animation   String?  // animation type
  price       Int      // price in credits
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  gifts       StreamGift[]

  @@map("gift_types")
}

// Gifts sent during streams
model StreamGift {
  id          String      @id @default(cuid())
  streamId    String
  senderId    String
  giftTypeId  String
  quantity    Int         @default(1)
  totalPrice  Int         // total credits spent
  createdAt   DateTime    @default(now())
  stream      VideoStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  sender      User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  giftType    GiftType    @relation(fields: [giftTypeId], references: [id])

  @@index([streamId])
  @@index([senderId])
  @@map("stream_gifts")
}

// WebRTC signaling for video streams
model VideoStreamSignal {
  id          String   @id @default(cuid())
  streamId    String
  senderId    String
  receiverId  String?
  signalType  String   // offer, answer, ice-candidate, join
  signalData  String   @db.Text
  processed   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([streamId])
  @@index([receiverId, processed])
  @@map("video_stream_signals")
}

// Co-broadcasters in video streams
model StreamCoBroadcaster {
  id          String      @id @default(cuid())
  streamId    String
  userId      String
  status      String      @default("invited") // invited, active, ended
  isMuted     Boolean     @default(false)
  isVideoOff  Boolean     @default(false)
  invitedAt   DateTime    @default(now())
  joinedAt    DateTime?
  leftAt      DateTime?

  @@unique([streamId, userId])
  @@index([streamId])
  @@index([userId])
  @@map("stream_co_broadcasters")
}

// Banned users from streams
model StreamBan {
  id            String   @id @default(cuid())
  streamId      String
  bannedUserId  String
  reason        String?
  bannedAt      DateTime @default(now())

  @@unique([streamId, bannedUserId])
  @@index([streamId])
  @@map("stream_bans")
}

// Direct Messages between users
model DirectMessage {
  id          String   @id @default(cuid())
  senderId    String
  receiverId  String
  content     String   @db.Text
  imageUrl    String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  sender      User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
  @@map("direct_messages")
}

// Conversation threads for DMs
model Conversation {
  id              String   @id @default(cuid())
  user1Id         String
  user2Id         String
  lastMessageAt   DateTime @default(now())
  lastMessageText String?
  createdAt       DateTime @default(now())
  user1           User     @relation("ConversationUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2           User     @relation("ConversationUser2", fields: [user2Id], references: [id], onDelete: Cascade)

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
  @@index([lastMessageAt])
  @@map("conversations")
}

// Message request (for users with restricted messaging)
model MessageRequest {
  id          String   @id @default(cuid())
  senderId    String
  receiverId  String
  status      String   @default("pending") // pending, accepted, rejected
  message     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sender      User     @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User     @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
  @@index([status])
  @@map("message_requests")
}

// User Activity Statistics - tracks login sessions
model UserLoginSession {
  id          String   @id @default(cuid())
  userId      String
  loginAt     DateTime @default(now())
  logoutAt    DateTime?
  duration    Int      @default(0) // in minutes
  deviceType  String?  // mobile, desktop, tablet
  browser     String?

  @@index([userId])
  @@index([loginAt])
  @@map("user_login_sessions")
}

// Daily activity tracking
model UserDailyActivity {
  id              String   @id @default(cuid())
  userId          String
  date            DateTime @db.Date
  minutesSpent    Int      @default(0)
  fortunesViewed  Int      @default(0)
  postsCreated    Int      @default(0)
  messagesCount   Int      @default(0)
  streamsWatched  Int      @default(0)
  creditsSpent    Int      @default(0)
  creditsEarned   Int      @default(0)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@map("user_daily_activity")
}

// Hourly activity pattern tracking
model UserHourlyActivity {
  id          String @id @default(cuid())
  userId      String
  hour        Int    // 0-23
  totalMinutes Int   @default(0)
  loginCount   Int   @default(0)

  @@unique([userId, hour])
  @@index([userId])
  @@map("user_hourly_activity")
}

// Coin/Credit transactions log
model CreditTransaction {
  id          String   @id @default(cuid())
  userId      String
  amount      Int      // positive for earned, negative for spent
  type        String   // purchase, gift_sent, gift_received, fortune, stream, reward, referral
  description String?
  relatedId   String?  // related fortune/stream/gift id
  balance     Int      // balance after transaction
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("credit_transactions")
}

// Fortune satisfaction/accuracy ratings
model FortuneRating {
  id            String   @id @default(cuid())
  fortuneId     String   @unique
  userId        String
  satisfaction  Int?     // 1-5 rating
  accuracy      Int?     // 1-5 rating (can be updated later)
  feedback      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([fortuneId])
  @@map("fortune_ratings")
}

// User Achievements/Badges
model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  earnedAt      DateTime @default(now())
  progress      Int      @default(0)
  isCompleted   Boolean  @default(false)

  @@unique([userId, achievementId])
  @@index([userId])
  @@map("user_achievements")
}

// Achievement definitions
model Achievement {
  id           String   @id @default(cuid())
  code         String   @unique
  nameTr       String
  nameEn       String
  descriptionTr String
  descriptionEn String
  icon         String
  category     String   // fortune, social, stream, coin, activity
  targetValue  Int      // target to complete
  rewardCredits Int     @default(0)
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("achievements")
}

// Bana Özel - Personalized Fortune Content Items
model BanaOzelItem {
  id           String   @id @default(cuid())
  slug         String   @unique
  nameTr       String
  nameEn       String
  descTr       String?
  descEn       String?
  icon         String   // emoji icon
  jetonCost    Int      @default(5)
  category     String   @default("fortune") // fortune, tarot, astrology, spiritual
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  contentPool  String?  @db.Text // JSON array of possible content/prompts
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
  @@map("bana_ozel_items")
}

// User jeton (token) balance and transactions
model JetonTransaction {
  id          String   @id @default(cuid())
  userId      String
  amount      Int      // positive for earned, negative for spent
  type        String   // spend, daily_bonus, streak_bonus, task, purchase, welcome
  description String?
  itemSlug    String?  // related BanaOzelItem slug
  balanceBefore Int
  balanceAfter  Int
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("jeton_transactions")
}

// Daily fortune streak tracking
model UserFortuneStreak {
  id            String   @id @default(cuid())
  userId        String   @unique
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  lastFortuneDate DateTime?
  totalFortunes Int      @default(0)

  @@index([userId])
  @@map("user_fortune_streaks")
}

// Daily task completion tracking
model DailyTask {
  id          String   @id @default(cuid())
  userId      String
  taskType    String   // login, open_fortune, share, watch_stream, profile_complete
  completedAt DateTime @default(now())
  jetonEarned Int      @default(0)
  date        DateTime @db.Date

  @@unique([userId, taskType, date])
  @@index([userId])
  @@index([date])
  @@map("daily_tasks")
}

// Bana Özel content history (what user opened)
model BanaOzelHistory {
  id         String   @id @default(cuid())
  userId     String
  itemSlug   String
  content    String   @db.Text // Generated content
  jetonSpent Int
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([itemSlug])
  @@index([createdAt])
  @@map("bana_ozel_history")
}

// Profile views tracking
model ProfileView {
  id          String   @id @default(cuid())
  viewedUserId String
  viewerId     String?
  viewedAt     DateTime @default(now())

  @@index([viewedUserId])
  @@index([viewedAt])
  @@map("profile_views")
}

// Gold Membership Plans
model MembershipPlan {
  id              String   @id @default(cuid())
  name            String   // Plan name (e.g., "Gold 1 Aylık")
  nameEn          String?  // English name
  description     String?  @db.Text
  descriptionEn   String?  @db.Text
  tier            String   // basic, premium, gold, diamond
  durationDays    Int      // Duration in days
  priceType       String   // jeton, money
  price           Int      // Price in jetons or currency minor units (kuruş)
  currency        String   @default("TRY") // For money payments
  features        String?  @db.Text // JSON array of features
  bonusJetons     Int      @default(0) // Bonus jetons on purchase
  discountPercent Int      @default(0) // Discount on fortune readings
  prioritySupport Boolean  @default(false)
  exclusiveBadge  String?  // Badge icon/text
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  isFeatured      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchases       MembershipPurchase[]
  
  @@index([tier])
  @@index([priceType])
  @@index([isActive])
  @@map("membership_plans")
}

// Membership Purchase History
model MembershipPurchase {
  id              String   @id @default(cuid())
  userId          String
  planId          String
  plan            MembershipPlan @relation(fields: [planId], references: [id])
  priceType       String   // jeton, money
  pricePaid       Int      // Amount paid
  currency        String   @default("TRY")
  startsAt        DateTime @default(now())
  expiresAt       DateTime
  status          String   @default("active") // active, expired, cancelled
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@index([expiresAt])
  @@map("membership_purchases")
}

// Payment Notifications (user notifies admin about payment)
model PaymentNotification {
  id              String   @id @default(cuid())
  userId          String
  username        String   // User's username at time of submission
  paymentMethod   String   // papara, bank_transfer, etc.
  amount          Float    // Amount paid in TRY
  transactionId   String?  // Transaction/Reference ID
  senderName      String?  // Name of sender (for bank transfers)
  notes           String?  @db.Text // Additional notes
  status          String   @default("pending") // pending, approved, rejected
  jetonLoaded     Int?     // Jeton amount loaded by admin
  processedBy     String?  // Admin who processed
  processedAt     DateTime?
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("payment_notifications")
}

