// PostgreSQL database configuration
generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "/home/ubuntu/fortune_telling_platform/nextjs_space/node_modules/.prisma/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  emailVerified     DateTime?
  password          String?
  name              String
  image             String?
  preferredLanguage String    @default("tr")
  credits           Int       @default(10)
  role              String    @default("user")
  createdAt         DateTime  @default(now())
  
  // Referral System
  referralCode          String?   @unique
  referredById          String?
  referredBy            User?     @relation("UserReferrals", fields: [referredById], references: [id])
  referrals             User[]    @relation("UserReferrals")
  referralCreditsEarned Int       @default(0)
  
  fortunes          Fortune[]
  accounts          Account[]
  sessions          Session[]
  chatMessages      ChatMessage[]
  chatPresences     ChatPresence[]
  chatRoles         ChatUserRole[]
  mutedIn           ChatMute[]  @relation("MutedUser")
  mutedOthers       ChatMute[]  @relation("Muter")
  bannedIn          ChatBan[]   @relation("BannedUser")
  bannedOthers      ChatBan[]   @relation("Banner")
  socialPosts       SocialPost[]
  socialComments    SocialComment[]
  socialLikes       SocialLike[]
  notifications     Notification[]
  referralHistory   Referral[]  @relation("Referrer")
  referredHistory   Referral[]  @relation("Referred")
  passwordResets    PasswordResetToken[]
  
  // Live Fortune Teller
  fortuneTellerProfile  LiveFortuneTeller?
  liveSessions          LiveSession[]  @relation("SessionUser")

  @@index([referralCode])
  @@index([referredById])
  @@map("users")
}

// Referral tracking
model Referral {
  id            String   @id @default(cuid())
  referrerId    String
  referredId    String
  creditsAwarded Int     @default(50)
  createdAt     DateTime @default(now())
  
  referrer      User     @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred      User     @relation("Referred", fields: [referredId], references: [id], onDelete: Cascade)

  @@unique([referrerId, referredId])
  @@index([referrerId])
  @@index([createdAt])
  @@map("referrals")
}

// Password Reset Tokens
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("password_reset_tokens")
}

// Live Fortune Teller Profile
model LiveFortuneTeller {
  id              String   @id @default(cuid())
  userId          String   @unique
  displayName     String
  bio             String?  @db.Text
  specialties     String[] // Array of fortune types they specialize in
  pricePerSession Int      @default(100) // Credits per session
  rating          Float    @default(5.0)
  totalSessions   Int      @default(0)
  totalReviews    Int      @default(0)
  totalEarnings   Int      @default(0) // Total credits earned
  isOnline        Boolean  @default(false)
  isVerified      Boolean  @default(false)
  isActive        Boolean  @default(true)
  avatar          String?
  
  // Application status
  applicationStatus String  @default("pending") // pending, approved, rejected
  applicationNote   String? @db.Text
  approvedAt        DateTime?
  rejectedAt        DateTime?
  
  // Ban system
  isBanned          Boolean  @default(false)
  banReason         String?  @db.Text
  bannedAt          DateTime?
  
  // Freeze system (earnings freeze)
  isFrozen          Boolean  @default(false)
  freezeReason      String?  @db.Text
  frozenAt          DateTime?
  
  // Bonus/Rewards
  bonusCredits      Int      @default(0)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions        LiveSession[]
  reviews         LiveTellerReview[]
  warnings        TellerWarning[]

  @@index([isOnline])
  @@index([isVerified])
  @@index([rating])
  @@index([applicationStatus])
  @@index([isBanned])
  @@map("live_fortune_tellers")
}

// Warnings for Fortune Tellers
model TellerWarning {
  id        String   @id @default(cuid())
  tellerId  String
  reason    String   @db.Text
  issuedBy  String   // Admin user ID
  createdAt DateTime @default(now())
  
  teller    LiveFortuneTeller @relation(fields: [tellerId], references: [id], onDelete: Cascade)

  @@index([tellerId])
  @@map("teller_warnings")
}

// Live Session between user and fortune teller
model LiveSession {
  id              String   @id @default(cuid())
  tellerId        String
  userId          String
  fortuneType     String
  status          String   @default("pending") // pending, active, completed, cancelled
  creditsCharged  Int
  startedAt       DateTime?
  endedAt         DateTime?
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  
  teller          LiveFortuneTeller @relation(fields: [tellerId], references: [id], onDelete: Cascade)
  user            User              @relation("SessionUser", fields: [userId], references: [id], onDelete: Cascade)
  messages        LiveSessionMessage[]
  review          LiveTellerReview?

  @@index([tellerId])
  @@index([userId])
  @@index([status])
  @@map("live_sessions")
}

// Messages within a live session
model LiveSessionMessage {
  id        String   @id @default(cuid())
  sessionId String
  senderId  String
  message   String   @db.Text
  createdAt DateTime @default(now())
  
  session   LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("live_session_messages")
}

// Reviews for fortune tellers
model LiveTellerReview {
  id        String   @id @default(cuid())
  tellerId  String
  sessionId String   @unique
  rating    Int      // 1-5
  comment   String?  @db.Text
  createdAt DateTime @default(now())
  
  teller    LiveFortuneTeller @relation(fields: [tellerId], references: [id], onDelete: Cascade)
  session   LiveSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([tellerId])
  @@map("live_teller_reviews")
}

model Fortune {
  id           String   @id @default(cuid())
  userId       String
  fortuneType  String
  inputData    String   @db.Text
  aiResponse   String
  language     String
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  socialPosts  SocialPost[]

  @@index([userId])
  @@index([fortuneType])
  @@index([createdAt])
  @@map("fortunes")
}

model Translation {
  id               String @id @default(cuid())
  languageCode     String
  translationKey   String
  translationValue String

  @@unique([languageCode, translationKey])
  @@index([languageCode])
  @@map("translations")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model ChatRoom {
  id          String        @id @default(cuid())
  slug        String        @unique
  nameEn      String
  nameTr      String
  descEn      String
  descTr      String
  icon        String
  isActive    Boolean       @default(true)
  isMuted     Boolean       @default(false)
  createdAt   DateTime      @default(now())
  messages    ChatMessage[]
  presences   ChatPresence[]
  userRoles   ChatUserRole[]
  mutes       ChatMute[]
  bans        ChatBan[]

  @@map("chat_rooms")
}

model ChatMessage {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())
  room      ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@index([userId])
  @@map("chat_messages")
}

model ChatPresence {
  id         String    @id @default(cuid())
  roomId     String
  userId     String
  nickname   String?
  isTyping   Boolean   @default(false)
  lastTyping DateTime?
  lastSeen   DateTime  @default(now())
  room       ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId])
  @@map("chat_presences")
}

// Chat user roles: founder (~), admin (&), op (@), voice (+)
model ChatUserRole {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  role      String   // founder, admin, op, voice
  grantedBy String?
  createdAt DateTime @default(now())
  room      ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId])
  @@map("chat_user_roles")
}

// Muted users in a room
model ChatMute {
  id        String    @id @default(cuid())
  roomId    String
  userId    String
  mutedBy   String
  reason    String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  room      ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, name: "MutedUser")
  muter     User      @relation(fields: [mutedBy], references: [id], onDelete: Cascade, name: "Muter")

  @@unique([roomId, userId])
  @@index([roomId])
  @@map("chat_mutes")
}

// Banned users from a room
model ChatBan {
  id        String    @id @default(cuid())
  roomId    String
  userId    String
  bannedBy  String
  reason    String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  room      ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, name: "BannedUser")
  banner    User      @relation(fields: [bannedBy], references: [id], onDelete: Cascade, name: "Banner")

  @@unique([roomId, userId])
  @@index([roomId])
  @@map("chat_bans")
}

// Site settings for ads and other configurations
model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// Social Posts - Users can share fortunes or custom text
model SocialPost {
  id          String    @id @default(cuid())
  userId      String
  fortuneId   String?   // Optional: linked fortune
  content     String    @db.Text
  imageUrl    String?   // Optional: image URL for the post
  audioUrl    String?   // Optional: audio URL for voice posts
  youtubeUrl  String?   // Optional: YouTube video URL
  postType    String    // "fortune", "text", "horoscope"
  fortuneType String?   // coffee, tarot, etc. if fortune post
  isAuto      Boolean   @default(false) // True if auto-shared from fortune
  isPublic    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fortune     Fortune?  @relation(fields: [fortuneId], references: [id], onDelete: SetNull)
  comments    SocialComment[]
  likes       SocialLike[]

  @@index([userId])
  @@index([createdAt])
  @@index([postType])
  @@map("social_posts")
}

// Comments on social posts
model SocialComment {
  id        String     @id @default(cuid())
  postId    String
  userId    String
  content   String     @db.Text
  createdAt DateTime   @default(now())
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
  @@map("social_comments")
}

// Likes on social posts
model SocialLike {
  id        String     @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime   @default(now())
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@map("social_likes")
}

// Anonymous users who use the platform without registration
model AnonymousUser {
  id              String   @id @default(cuid())
  username        String   @unique
  deviceId        String   @unique
  credits         Int      @default(0)
  adsWatched      Int      @default(0)
  adsWatchedToday Int      @default(0)
  lastAdDate      DateTime?
  fortunesUsed    Int      @default(0)
  createdAt       DateTime @default(now())
  anonymousFortunes AnonymousFortune[]

  @@map("anonymous_users")
}

// Fortune readings for anonymous users
model AnonymousFortune {
  id              String        @id @default(cuid())
  anonymousUserId String
  fortuneType     String
  inputData       String        @db.Text
  aiResponse      String        @db.Text
  language        String
  createdAt       DateTime      @default(now())
  anonymousUser   AnonymousUser @relation(fields: [anonymousUserId], references: [id], onDelete: Cascade)

  @@index([anonymousUserId])
  @@map("anonymous_fortunes")
}

// Site-wide presence tracking for visitor count
model SitePresence {
  id        String   @id @default(cuid())
  visitorId String   @unique // Session ID or user ID
  userId    String?  // Optional: logged-in user
  lastSeen  DateTime @default(now())
  userAgent String?
  path      String?  // Current page path

  @@index([lastSeen])
  @@map("site_presences")
}

// Persistent site visit tracking for analytics
model SiteVisit {
  id        String   @id @default(cuid())
  visitorId String   // Unique visitor identifier
  userId    String?  // Optional: logged-in user
  visitedAt DateTime @default(now())
  path      String?  // Page visited
  userAgent String?
  country   String?  // Country code (TR, US, etc.)
  city      String?  // City name
  ipHash    String?  // Hashed IP for privacy

  @@index([visitedAt])
  @@index([visitorId])
  @@index([country])
  @@map("site_visits")
}

// Notifications for users (likes, comments, etc.)
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // "like", "comment", "share"
  message   String
  postId    String?
  fromUserId String?
  fromUserName String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}
